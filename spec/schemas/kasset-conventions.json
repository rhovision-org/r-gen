{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhovision-org.github.io/r-gen/schemas/kasset-conventions-v1.json",
  "title": "r-gen K-Asset conventions v1",
  "description": "The state shape and status semantics that interoperating consumers may rely on. This is a versioned interface convention, not an on-chain guarantee: the Pareto core stores these fields but does not validate the quality rubric, quantity shape or liability shape.",
  "type": "object",
  "required": [
    "quantity",
    "quality",
    "verdict",
    "status"
  ],
  "properties": {
    "quantity": {
      "type": "object",
      "required": [
        "unit",
        "value"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "required": [
        "completeness",
        "correctness",
        "traceability",
        "fitness"
      ],
      "properties": {
        "completeness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "correctness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "traceability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "fitness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "additionalProperties": false,
      "x-sum-minimum": 4,
      "x-sum-maximum": 20
    },
    "variance": {
      "type": "object",
      "required": [
        "quantityBps",
        "qualityBps",
        "n"
      ],
      "properties": {
        "quantityBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "qualityBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "curve": {
          "type": "object",
          "required": [
            "kind",
            "unit",
            "n",
            "points"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "quantiles"
            },
            "unit": {
              "const": "bpsOfDeclaredValue"
            },
            "n": {
              "const": 16
            },
            "points": {
              "type": "array",
              "minItems": 16,
              "maxItems": 16,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "verdict": {
      "type": "string",
      "enum": [
        "valid",
        "partial",
        "invalid"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "validated",
        "conditional",
        "rejected",
        "approved",
        "disputed",
        "upheld",
        "revoked",
        "partially_revoked"
      ]
    },
    "approval": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "decision",
        "liability"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "conditional"
          ]
        },
        "liability": {
          "type": "object",
          "required": [
            "responsible",
            "shareBps"
          ],
          "properties": {
            "responsible": {
              "type": "string",
              "minLength": 1
            },
            "shareBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "basisHash": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "type": "object",
            "required": [
              "decision",
              "liability"
            ]
          }
        }
      }
    }
  ],
  "x-conventions": {
    "version": "kasset.conventions/v1",
    "enforcedByCore": false,
    "qualityRubric": {
      "dimensions": [
        "completeness",
        "correctness",
        "traceability",
        "fitness"
      ],
      "range": "integer 1..5 each",
      "sum": "4..20",
      "missingOrOutOfRange": "refuse derivation; require a bound attestation"
    },
    "statusLifecycle": {
      "mint": {
        "valid": "validated",
        "partial": "conditional",
        "invalid": "rejected"
      },
      "approval": "validated or conditional -> approved or rejected",
      "dispute": "approved -> disputed -> upheld, revoked, or partially_revoked"
    },
    "automaticDerivationStatuses": [
      "approved"
    ],
    "attestationRequiredStatuses": [
      "validated",
      "conditional",
      "disputed",
      "upheld",
      "revoked",
      "partially_revoked",
      "rejected"
    ],
    "engineeringVarianceBps": {
      "formula": "(20 - qualitySum) * 500 + verdictPenalty",
      "verdictPenalty": {
        "valid": 0,
        "partial": 1000
      },
      "invalid": "rejected at mint; not eligible for automatic derivation",
      "range": "0..9000 for approved assets with a valid or partial verdict",
      "liabilityShareUsed": false
    },
    "liabilityShare": {
      "meaning": "the approver's declared share of liability, 0..10000 bps",
      "engineeringSignal": false,
      "note": "A lower share is an indemnity or co-insurance allocation, not evidence of higher engineering variance. Do not add a liability penalty to the engineering rate."
    }
  }
}
