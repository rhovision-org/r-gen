// Why: "The asset becomes the keeper of its own information" (NSPE p.29) and the Bridge paper's
//      sealing/provenance requirement (p.3, p.6). One provenance cell per asset; anchors and
//      comments append under a single writer order, so no update is lost. parentHash gives the
//      minimal document graph the papers imply without a global registry.
// Paper: @robles2016nspe p.29; @zhong2019bridge p.3, p.6.
// r-gen decision: comment rights are the asset's declared writers; a broader stakeholder-identity
//      comment gate is an extension.
// Placeholders: __ROOT_URI__.
new
  ProvenanceFactory,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, cFactory, ack1,
  authOwner, authSubject, authPubKey, nowHeight,
  listHas, listHasId, listHasAny, listHas3,
  listHasEq, listHasIdEq, listHasAnyEq, listHas3Eq,
  provenanceSubject, provenanceCreate, parentCheck, commitAnchor
in {
  // @@INLINE:lib/Auth.rho@@
  // @@INLINE:lib/Time.rho@@
  // @@INLINE:lib/List.rho@@

  // Provenance is created against a subject capability, not a free asset
  // reference. The factory reads the subject cell and derives assetRef from the
  // subject's own uri; a caller cannot name a different asset (RGA-022).
  contract ProvenanceFactory(@"createBound", dId, subjectCap, @writers, ret) = {
    new aCh in {
      authOwner!(*dId, *aCh) |
      for (@(true, creator, pk) <- aCh) {
        new gCh in {
          subjectCap!("get", *gCh) |
          for (@g <- gCh) { provenanceSubject!(g, creator, writers, *ret) }
        }
      }
    }
  } |

  contract provenanceSubject(@g, @creator, @writers, ret) = {
    match g {
      (true, subject) => {
        match subject.get("uri") {
          Nil => { ret!((false, "asset")) }
          uri => {
            if (uri.toString() == "" || writers.length() == 0) {
              ret!((false, "writers or asset"))
            } else { provenanceCreate!(subject, creator, writers, *ret) }
          }
        }
      }
      _ => { ret!((false, "asset")) }
    }
  } |

  contract provenanceCreate(@subject, @creator, @writers, ret) = {
    new pState, Provenance, uriCh in {
      pState!({
        "uri": "",
        "assetRef": {"id": subject.get("uri").toString(),
                     "uri": subject.get("uri").toString(),
                     "claimRef": subject.get("claimRef")},
        "writers": [creator] ++ writers,
        "anchors": [],
        "comments": [],
        "version": 1
      }) |

      contract Provenance(@"get", ret2) = {
        for (@s <<- pState) { ret2!((true, s)) }
      } |

      contract Provenance(@"anchors", ret2) = {
        for (@s <<- pState) { ret2!((true, s.get("anchors"))) }
      } |

      contract Provenance(@"anchor", dId, @doc, ret2) = {
        new aCh, hCh in {
          authSubject!(*dId, *aCh) |
          nowHeight!(*hCh) |
          for (@(true, who) <- aCh; @now <- hCh) {
            for (@s <- pState) {
              new wCh in {
                listHas!(s.get("writers"), who, *wCh) |
                for (@writer <- wCh) {
                  match (writer, doc) {
                    (false, _) => { pState!(s) | ret2!((false, "not writer")) }
                    (true, {"hash": hash, ..._}) => {
                      if (hash == Nil || hash == "") {
                        pState!(s) | ret2!((false, "hash"))
                      } else {
                        new dupCh in {
                          listHasId!(s.get("anchors"), hash, *dupCh) |
                          for (@dup <- dupCh) {
                            if (dup) {
                              pState!(s) | ret2!((false, "duplicate"))
                            } else {
                              parentCheck!(hash, doc, s, who, now, *ret2)
                            }
                          }
                        }
                      }
                    }
                    _ => { pState!(s) | ret2!((false, "hash")) }
                  }
                }
              }
            }
          }
        }
      } |

      contract parentCheck(@hash, @doc, @s, @who, @now, ret2) = {
        match doc.get("parentHash") {
          Nil => { commitAnchor!(hash, doc, s, who, now, *ret2) }
          "" => { commitAnchor!(hash, doc, s, who, now, *ret2) }
          p => {
            new pc in {
              listHasId!(s.get("anchors"), p, *pc) |
              for (@has <- pc) {
                if (has) { commitAnchor!(hash, doc, s, who, now, *ret2) }
                else { pState!(s) | ret2!((false, "parent")) }
              }
            }
          }
        }
      } |

      contract commitAnchor(@hash, @doc, @s, @who, @now, ret2) = {
        pState!(s.set("anchors", s.get("anchors") ++ [{
          "id": hash,
          "kind": doc.get("kind"),
          "hash": hash,
          "parentHash": doc.get("parentHash"),
          "by": who, "at": now}])
          .set("version", s.get("version") + 1)) |
        ret2!((true, Nil))
      } |

      contract Provenance(@"comment", dId, @comment, ret2) = {
        new aCh, hCh in {
          authSubject!(*dId, *aCh) |
          nowHeight!(*hCh) |
          for (@(true, who) <- aCh; @now <- hCh) {
            for (@s <- pState) {
              new wCh in {
                listHas!(s.get("writers"), who, *wCh) |
                for (@writer <- wCh) {
                  if (not writer) {
                    pState!(s) | ret2!((false, "not writer"))
                  } else {
                    if (comment.get("hash") == Nil || comment.get("hash") == "") {
                      pState!(s) | ret2!((false, "hash"))
                    } else {
                      pState!(s.set("comments", s.get("comments") ++ [{
                        "id": "cm:" ++ who ++ ":" ++ now.toString(),
                        "by": who, "hash": comment.get("hash"), "at": now}])
                        .set("version", s.get("version") + 1)) |
                      ret2!((true, Nil))
                    }
                  }
                }
              }
            }
          }
        }
      } |

      contract Provenance(@"verify", @hash, ret2) = {
        for (@s <<- pState) {
          new ch in {
            listHasId!(s.get("anchors"), hash, *ch) |
            for (@found <- ch) { ret2!((true, found)) }
          }
        }
      } |

      rs!(bundle+{*Provenance}, *uriCh) |
      for (@uri <- uriCh) {
        for (@s2 <- pState) { pState!(s2.set("uri", uri)) } |
        ret!((true, {"id": uri, "uri": uri}))
      }
    }
  } |

  rs!(bundle+{*ProvenanceFactory}, *cFactory) |
  for (@uri <- cFactory) {
    rl!(`__ROOT_URI__`, *rootCh) |
    for (Root <- rootCh) {
      Root!("register", "component:provenance-factory", uri, 1, "provenance",
            *deployerId, *ack1) |
      for (@r <- ack1) { deployId!([("provenance-factory", uri)]) }
    }
  }
}
