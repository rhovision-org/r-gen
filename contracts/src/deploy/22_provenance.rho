// ProvenanceBook: seals, anchors and stakeholder comments. Append-only.
// Placeholders: __ROOT_URI__, __ADMINS__, __THRESHOLD__.
new
  ProvenanceBook, provenanceState,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, c, ack,
  adminGuard, resolveComponent, nowHeight,
  authOwner, authSubject, authPubKey, authIsOwner,
  anchorHas
in {
  // @@INLINE:lib/Resolve.rho@@
  // @@INLINE:lib/Auth.rho@@
  // @@INLINE:lib/AdminGuard.rho@@
  // @@INLINE:lib/Time.rho@@

  contract anchorHas(@list, @hash, @i, ret) = {
    if (i >= list.length()) { ret!(false) }
    else {
      match list.nth(i) {
        a => {
          if (a.get("hash") == hash) { ret!(true) }
          else { anchorHas!(list, hash, i + 1, *ret) }
        }
      }
    }
  } |

  contract ProvenanceBook(@"seal", dId, @seal, ret) = {
    new aCh, hCh in {
      authSubject!(*dId, *aCh) |
      nowHeight!(*hCh) |
      for (@(true, subject) <- aCh; @height <- hCh) {
        for (@s <- provenanceState) {
          if (seal.get("docHash") == "" || seal.get("docHash") == Nil) {
            provenanceState!(s) | ret!((false, "doc"))
          } else {
            match "sl:" ++ subject ++ ":" ++ s.get("nonce").toString() {
              sealId => {
                provenanceState!(s.set("seals", s.get("seals").set(sealId, {
                  "id": sealId, "subject": subject, "titleHash": seal.get("titleHash"),
                  "docHash": seal.get("docHash"), "kind": seal.get("kind"),
                  "at": height })).set("nonce", s.get("nonce") + 1)) |
                ret!((true, sealId))
              }
            }
          }
        }
      }
    }
  } |

  contract ProvenanceBook(@"anchor", dId, @ref, @doc, ret) = {
    new aCh, hCh in {
      authSubject!(*dId, *aCh) |
      nowHeight!(*hCh) |
      for (@(true, who) <- aCh; @height <- hCh) {
        for (@s <- provenanceState) {
          if (ref == "") {
            provenanceState!(s) | ret!((false, "ref"))
          } else {
            if (doc.get("hash") == "" || doc.get("hash") == Nil) {
              provenanceState!(s) | ret!((false, "hash"))
            } else {
              match "an:" ++ ref ++ ":" ++ s.get("nonce").toString() {
                anchorId => {
                  match s.get("anchors").get(ref) {
                    Nil => {
                      provenanceState!(s.set("anchors",
                        s.get("anchors").set(ref, [{
                          "id": anchorId, "kind": doc.get("kind"),
                          "hash": doc.get("hash"), "by": who, "at": height }]))
                        .set("nonce", s.get("nonce") + 1)) |
                      ret!((true, anchorId))
                    }
                    list => {
                      provenanceState!(s.set("anchors",
                        s.get("anchors").set(ref, list ++ [{
                          "id": anchorId, "kind": doc.get("kind"),
                          "hash": doc.get("hash"), "by": who, "at": height }]))
                        .set("nonce", s.get("nonce") + 1)) |
                      ret!((true, anchorId))
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract ProvenanceBook(@"comment", dId, @ref, @comment, ret) = {
    new aCh, hCh, iCh in {
      authSubject!(*dId, *aCh) |
      nowHeight!(*hCh) |
      resolveComponent!("component:identity", *iCh) |
      for (@(true, who) <- aCh; @height <- hCh; @ir <- iCh) {
        match ir {
          (true, IdentityBook) => {
            new pCh in {
              @IdentityBook!("profile", who, *pCh) |
              for (@p <- pCh) {
                match p {
                  (true, _) => {
                    for (@s <- provenanceState) {
                      if (comment.get("hash") == "" || comment.get("hash") == Nil) {
                        provenanceState!(s) | ret!((false, "hash"))
                      } else {
                        match "cm:" ++ ref ++ ":" ++ s.get("nonce").toString() {
                          commentId => {
                            match s.get("comments").get(ref) {
                              Nil => {
                                provenanceState!(s.set("comments",
                                  s.get("comments").set(ref, [{
                                    "id": commentId, "hash": comment.get("hash"),
                                    "by": who, "at": height }]))
                                  .set("nonce", s.get("nonce") + 1)) |
                                ret!((true, commentId))
                              }
                              list => {
                                provenanceState!(s.set("comments",
                                  s.get("comments").set(ref, list ++ [{
                                    "id": commentId, "hash": comment.get("hash"),
                                    "by": who, "at": height }]))
                                  .set("nonce", s.get("nonce") + 1)) |
                                ret!((true, commentId))
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => { ret!((false, "not registered")) }
                }
              }
            }
          }
          _ => { ret!((false, "unavailable", "component:identity")) }
        }
      }
    }
  } |

  contract ProvenanceBook(@"verify", @ref, @hash, ret) = {
    for (@s <<- provenanceState) {
      new aCh in {
        match s.get("anchors").get(ref) {
          Nil => { aCh!(false) }
          list => { anchorHas!(list, hash, 0, *aCh) }
        } |
        for (@found <- aCh) {
          if (found) { ret!((true, true)) }
          else {
            match s.get("seals").get(ref) {
              Nil => { ret!((true, false)) }
              seal => { ret!((true, seal.get("docHash") == hash)) }
            }
          }
        }
      }
    }
  } |

  contract ProvenanceBook(@"seal", @sealId, ret) = {
    for (@s <<- provenanceState) {
      match s.get("seals").get(sealId) {
        Nil => { ret!((false, "unknown seal")) }
        seal => { ret!((true, seal)) }
      }
    }
  } |

  contract ProvenanceBook(@"anchors", @ref, ret) = {
    for (@s <<- provenanceState) {
      match s.get("anchors").get(ref) {
        Nil => { ret!((true, [])) }
        list => { ret!((true, list)) }
      }
    }
  } |

  contract ProvenanceBook(@"comments", @ref, ret) = {
    for (@s <<- provenanceState) {
      match s.get("comments").get(ref) {
        Nil => { ret!((true, [])) }
        list => { ret!((true, list)) }
      }
    }
  } |

  contract ProvenanceBook(@"admin", @nonce, @action, @args, @sigs, ret) = {
    for (@s <- provenanceState) {
      if (nonce <= s.get("govNonce")) {
        provenanceState!(s) | ret!((false, "replay"))
      } else {
        new vCh in {
          adminGuard!("provenance", nonce, action, args, sigs,
                      s.get("admins"), s.get("threshold"), *vCh) |
          for (@v <- vCh) {
            match v {
              (true, ok) => {
                if (ok == false) {
                  provenanceState!(s) | ret!((false, "below threshold"))
                } else {
                  match action {
                    "setAdmins" => {
                      match args.nth(0) {
                        newAdmins => {
                          match args.nth(1) {
                            newThreshold => {
                              if (newThreshold < 1 || newThreshold > newAdmins.length()) {
                                provenanceState!(s) | ret!((false, "threshold"))
                              } else {
                                provenanceState!(s.set("admins", newAdmins)
                                  .set("threshold", newThreshold)
                                  .set("govNonce", nonce)) |
                                ret!((true, Nil))
                              }
                            }
                          }
                        }
                      }
                    }
                    "setThreshold" => {
                      match args.nth(0) {
                        newThreshold => {
                          if (newThreshold < 1 || newThreshold > s.get("admins").length()) {
                            provenanceState!(s) | ret!((false, "threshold"))
                          } else {
                            provenanceState!(s.set("threshold", newThreshold)
                              .set("govNonce", nonce)) |
                            ret!((true, Nil))
                          }
                        }
                      }
                    }
                    _ => { provenanceState!(s) | ret!((false, "unknown action")) }
                  }
                }
              }
              _ => { provenanceState!(s) | ret!((false, "below threshold")) }
            }
          }
        }
      }
    }
  } |

  provenanceState!({
    "seals": {}, "anchors": {}, "comments": {}, "nonce": 0,
    "admins": __ADMINS__, "threshold": __THRESHOLD__, "govNonce": 0
  }) |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*ProvenanceBook}, *c) |
    for (@uri <- c) {
      Root!("register", "component:provenance-book", uri, 1, "provenance",
            *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
