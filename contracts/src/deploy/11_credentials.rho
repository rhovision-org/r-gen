// Why: "Permissioned by Qualifications" (BIM p.7) and "validation of credentials should be in
//      place before validation of events" (Bridge p.6). A credential is a per-credential linear
//      cell; revocation is a single transition. The factory closes over the genuine genesis
//      Issuer, so a caller cannot substitute a fake issuer capability, and it keeps an issued
//      registry so a claim cannot be fooled by a forged credential.
// Paper: @mathews2017bim p.7; @zhong2019bridge p.6; @robles2016nspe p.25; @robles2016naic p.9
// r-gen decision: one genesis Issuer cell; issuer chains are a governance extension. The
//      factory registry is a deliberate issuance serialization point; validation reads do not
//      touch it.
// Placeholders: __ROOT_URI__.
new
  factoryState,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, issuerUriCh, factoryUriCh, ack1, ack2, ack3,
  authOwner, authSubject, authPubKey, nowHeight,
  listHas, listHasId, listHasAny, listHas3,
  listHasEq, listHasIdEq, listHasAnyEq, listHas3Eq,
  minLevelOf, scopeMatches, scopeMatchesLevel, issuerCovers,
  credentialReqOk
in {
  // @@INLINE:lib/Auth.rho@@
  // @@INLINE:lib/Time.rho@@
  // @@INLINE:lib/List.rho@@
  // @@INLINE:lib/Scope.rho@@

  contract credentialReqOk(@req, ret) = {
    match (req.get("subject"), req.get("ctype"), req.get("discipline"),
           req.get("jurisdiction"), req.get("role"), req.get("level"),
           req.get("expiresAt")) {
      (subject, ctype, discipline, jurisdiction, role, level, expiresAt) => {
        if (subject == Nil || subject == ""
            || ctype == Nil || ctype == ""
            || discipline == Nil || discipline == ""
            || jurisdiction == Nil || jurisdiction == ""
            || role == Nil || role == ""
            || level == Nil || level < 0
            || expiresAt == Nil || expiresAt < 0) { ret!(false) }
        else { ret!(true) }
      }
    }
  } |

  factoryState!({"issued": {}, "version": 0}) |

  authSubject!(*deployerId, *ack1) |
  for (@(true, genesis) <- ack1) {
    new Issuer, CredentialFactory, issuerState in {
      issuerState!({
        "subject": genesis,
        "types": ["*"],
        "disciplines": ["*"],
        "jurisdictions": ["*"],
        "roles": ["*"],
        "maxLevel": 3,
        "status": "active",
        "expiresAt": 0,
        "revokedAt": Nil,
        "createdAt": 0,
        "version": 1
      }) |

      contract Issuer(@"get", ret) = {
        for (@s <<- issuerState) { ret!((true, s)) }
      } |

      contract Issuer(@"authorize", dId, @req, @atHeight, ret) = {
        new aCh in {
          authSubject!(*dId, *aCh) |
          for (@r <- aCh) {
            match r {
              (true, caller) => {
                for (@s <<- issuerState) {
                  match (caller == s.get("subject"), s.get("status") == "active",
                         s.get("expiresAt") == 0 || atHeight <= s.get("expiresAt")) {
                    (false, _, _) => { ret!((true, false, "not issuer")) }
                    (true, false, _) => { ret!((true, false, "issuer revoked")) }
                    (true, true, false) => { ret!((true, false, "issuer expired")) }
                    (true, true, true) => {
                      new c in {
                        issuerCovers!(s, req, *c) |
                        for (@ok <- c) {
                          match ok {
                            true => { ret!((true, true)) }
                            false => { ret!((true, false, "issuer scope")) }
                          }
                        }
                      }
                    }
                    _ => { ret!((true, false, "not issuer")) }
                  }
                }
              }
              _ => { ret!((true, false, "not issuer")) }
            }
          }
        }
      } |

      contract Issuer(@"covers", @req, @atHeight, ret) = {
        for (@s <<- issuerState) {
          if (s.get("status") != "active") {
            ret!((true, false, "issuer revoked"))
          } else {
            if (s.get("expiresAt") != 0 && atHeight > s.get("expiresAt")) {
              ret!((true, false, "issuer expired"))
            } else {
              new c in {
                issuerCovers!(s, req, *c) |
                for (@ok <- c) { ret!((true, ok)) }
              }
            }
          }
        }
      } |

      contract CredentialFactory(@"verify", @uri, ret) = {
        for (@s <<- factoryState) {
          match s.get("issued").get(uri.toString()) {
            Nil => { ret!((false, "unknown credential")) }
            rec => { ret!((true, rec)) }
          }
        }
      } |

      contract CredentialFactory(@"count", ret) = {
        for (@s <<- factoryState) { ret!((true, s.get("issued").size())) }
      } |

      contract CredentialFactory(@"issue", dId, @req, ret) = {
        new aCh, hCh in {
          authSubject!(*dId, *aCh) |
          nowHeight!(*hCh) |
          for (@(true, issuer) <- aCh; @height <- hCh) {
            new fCh in {
              credentialReqOk!(req, *fCh) |
              for (@fieldsOk <- fCh) {
                if (not fieldsOk) {
                  ret!((false, "fields"))
                } else {
                  new authCh in {
                    Issuer!("authorize", *dId, req.set("minLevel", req.get("level")), height, *authCh) |
              for (@a <- authCh) {
                match a {
                  (true, true) => {
                      if (req.get("subject") == issuer) {
                        ret!((false, "self issue"))
                      } else {
                      new credState, Credential, uriCh in {
                        credState!({
                          "uri": "",
                          "subject": req.get("subject"),
                          "issuer": issuer,
                          "issuerUri": req.get("issuerUri"),
                          "ctype": req.get("ctype"),
                          "discipline": req.get("discipline"),
                          "jurisdiction": req.get("jurisdiction"),
                          "role": req.get("role"),
                          "level": req.get("level"),
                          "evidenceHash": req.get("evidenceHash"),
                          "issuedAt": height,
                          "expiresAt": req.get("expiresAt"),
                          "status": "active",
                          "revokedAt": Nil,
                          "reason": Nil,
                          "attestations": [],
                          "renewals": [],
                          "version": 1
                        }) |
                        contract Credential(@"get", ret2) = {
                          for (@cs <<- credState) { ret2!((true, cs)) }
                        } |
                        contract Credential(@"check", @caller, @rq, @atHeight, ret2) = {
                          for (@cs <<- credState) {
                            match (caller == cs.get("subject"), cs.get("status") == "active") {
                              (false, _) => { ret2!((true, false, "not subject")) }
                              (true, false) => { ret2!((true, false, "revoked")) }
                              (true, true) => {
                                if (cs.get("expiresAt") == 0
                                    || atHeight <= cs.get("expiresAt")) {
                                  new smCh, isCh in {
                                    scopeMatches!(cs, rq, *smCh) |
                                    Issuer!("covers", rq, atHeight, *isCh) |
                                    for (@sm <- smCh; @isr <- isCh) {
                                      match (sm, isr) {
                                        (_, (true, true)) => {
                                          match sm {
                                            true => { ret2!((true, true, cs.get("uri"))) }
                                            false => { ret2!((true, false, "scope")) }
                                          }
                                        }
                                        _ => { ret2!((true, false, "issuer")) }
                                      }
                                    }
                                  }
                                } else { ret2!((true, false, "expired")) }
                              }
                              _ => { ret2!((true, false, "not subject")) }
                            }
                          }
                        } |
                        contract Credential(@"prove", dId2, @rq, ret2, proofCh) = {
                          new a2, h2 in {
                            authSubject!(*dId2, *a2) |
                            nowHeight!(*h2) |
                            for (@(true, who) <- a2; @height <- h2) {
                              for (@cs <- credState) {
                                match (who == cs.get("subject"), cs.get("status") == "active") {
                                  (false, _) => { credState!(cs) | ret2!((false, "not subject")) }
                                  (true, false) => { credState!(cs) | ret2!((false, "revoked")) }
                                  (true, true) => {
                                    if (cs.get("expiresAt") == 0
                                        || height <= cs.get("expiresAt")) {
                                      new smCh, isCh in {
                                        scopeMatches!(cs, rq, *smCh) |
                                        Issuer!("covers", rq, height, *isCh) |
                                        for (@sm <- smCh; @isr <- isCh) {
                                          match (sm, isr) {
                                            (_, (true, true)) => {
                                              match sm {
                                                true => {
                                                  new proofState, Proof in {
                                                    proofState!({
                                                      "data": {
                                                        "uri": "proof:" ++ cs.get("uri").toString() ++ ":" ++ height.toString(),
                                                        "subject": cs.get("subject"),
                                                        "requirement": rq,
                                                        "atHeight": height,
                                                        "level": cs.get("level"),
                                                        "credentialUri": cs.get("uri").toString()
                                                      },
                                                      "used": false
                                                    }) |
                                                    contract Proof(@"take", ret3) = {
                                                      for (@p <- proofState) {
                                                        if (p.get("used")) {
                                                          proofState!(p) | ret3!((false, "used"))
                                                        } else {
                                                          proofState!(p.set("used", true)) |
                                                          ret3!((true, p.get("data")))
                                                        }
                                                      }
                                                    } |
                                                    credState!(cs) |
                                                    proofCh!(bundle+{*Proof}) |
                                                    ret2!((true, Nil))
                                                  }
                                                }
                                                false => { credState!(cs) | ret2!((false, "scope")) }
                                              }
                                            }
                                            _ => { credState!(cs) | ret2!((false, "issuer")) }
                                          }
                                        }
                                      }
                                    } else { credState!(cs) | ret2!((false, "expired")) }
                                  }
                                  _ => { credState!(cs) | ret2!((false, "not subject")) }
                                }
                              }
                            }
                          }
                        } |

                        contract Credential(@"revoke", dId2, @reason, ret2) = {
                          new a2, h2 in {
                            authSubject!(*dId2, *a2) |
                            nowHeight!(*h2) |
                            for (@(true, who) <- a2; @now <- h2) {
                              for (@cs <- credState) {
                                if (who != cs.get("issuer") && who != cs.get("subject")) {
                                  credState!(cs) | ret2!((false, "not authorized"))
                                } else {
                                  if (cs.get("status") != "active") {
                                    credState!(cs) | ret2!((false, "already revoked"))
                                  } else {
                                    credState!(cs.set("status", "revoked")
                                                 .set("revokedAt", now)
                                                 .set("reason", reason)
                                                 .set("version", cs.get("version") + 1)) |
                                    ret2!((true, Nil))
                                  }
                                }
                              }
                            }
                          }
                        } |
                        contract Credential(@"renew", dId2, @expiresAt, @evidenceHash, ret2) = {
                          new a2, h2 in {
                            authSubject!(*dId2, *a2) |
                            nowHeight!(*h2) |
                            for (@(true, who) <- a2; @now <- h2) {
                              for (@cs <- credState) {
                                if (who != cs.get("issuer")) {
                                  credState!(cs) | ret2!((false, "not issuer"))
                                } else {
                                  if (cs.get("status") != "active") {
                                    credState!(cs) | ret2!((false, "not active"))
                                  } else {
                                    credState!(cs.set("expiresAt", expiresAt)
                                                 .set("renewals", cs.get("renewals") ++ [{
                                                   "at": now, "expiresAt": expiresAt,
                                                   "evidenceHash": evidenceHash }])
                                                 .set("version", cs.get("version") + 1)) |
                                    ret2!((true, Nil))
                                  }
                                }
                              }
                            }
                          }
                        } |
                        contract Credential(@"attest", dId2, @hash, ret2) = {
                          new a2, h2 in {
                            authSubject!(*dId2, *a2) |
                            nowHeight!(*h2) |
                            for (@(true, who) <- a2; @now <- h2) {
                              for (@cs <- credState) {
                                if (who == cs.get("subject")) {
                                  credState!(cs) | ret2!((false, "self attest"))
                                } else {
                                  new dupCh in {
                                    listHasId!(cs.get("attestations"), who, *dupCh) |
                                    for (@dup <- dupCh) {
                                      if (dup) {
                                        credState!(cs) | ret2!((false, "already attested"))
                                      } else {
                                        credState!(cs.set("attestations",
                                          cs.get("attestations") ++ [{"id": who, "by": who,
                                                                       "hash": hash, "at": now}])
                                          .set("version", cs.get("version") + 1)) |
                                        ret2!((true, Nil))
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        } |
                        rs!(bundle+{*Credential}, *uriCh) |
                        for (@uri <- uriCh) {
                          for (@cs2 <- credState) { credState!(cs2.set("uri", uri)) } |
                          for (@s <- factoryState) {
                            factoryState!(s.set("issued", s.get("issued").set(uri.toString(), {
                              "issuer": issuer,
                              "subject": req.get("subject"),
                              "ctype": req.get("ctype"),
                              "discipline": req.get("discipline"),
                              "jurisdiction": req.get("jurisdiction"),
                              "role": req.get("role"),
                              "level": req.get("level")}))
                              .set("version", s.get("version") + 1))
                          } |
                          ret!((true, uri))
                        }
                      }
                      }
                    }
                  _ => { ret!(a) }
                }
              }
            }
                  }
                }
              }
          }
        }
      } |

      rs!(bundle+{*Issuer}, *issuerUriCh) |
      rs!(bundle+{*CredentialFactory}, *factoryUriCh) |
      for (@issuerUri <- issuerUriCh; @factoryUri <- factoryUriCh) {
        rl!(`__ROOT_URI__`, *rootCh) |
        for (Root <- rootCh) {
          Root!("register", "component:issuer", issuerUri, 1, "credentials",
                *deployerId, *ack2) |
          Root!("register", "component:credential-factory", factoryUri, 1, "credentials",
                *deployerId, *ack3) |
          for (@r1 <- ack2; @r2 <- ack3) {
            deployId!([("issuer", issuerUri), ("credential-factory", factoryUri)])
          }
        }
      }
    }
  }
}
