// Why: GenRoot is installer-gated discovery infrastructure, not a paper primitive. Core
//      contracts are wired to factory URIs at install time and never resolve Root at runtime.
// Paper: none (engineering infrastructure).
// RGen decision: no admin/freeze/rotate arms; the core is immutable. Upgrade by deploying a
//      new core and a new Root.
// Placeholders: none.
new
  GenRoot, rootState,
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  uriCh, ackCh, ackCh2,
  authOwner, authSubject, authPubKey
in {
  // @@INLINE:lib/Auth.rho@@

  contract GenRoot(@"resolve", @key, ret) = {
    for (@s <<- rootState) {
      match s.get("entries").get(key) {
        Nil => { ret!((false, "unknown component")) }
        e => { ret!((true, e.get("uri"), e.get("version"))) }
      }
    }
  } |

  contract GenRoot(@"get", @key, ret) = {
    for (@s <<- rootState) {
      match s.get("entries").get(key) {
        Nil => { ret!((false, "unknown component")) }
        e => { ret!((true, e)) }
      }
    }
  } |

  contract GenRoot(@"keys", ret) = {
    for (@s <<- rootState) { ret!((true, s.get("entries").keys())) }
  } |

  contract GenRoot(@"register", @key, @uri, @version, @kind, dId, ret) = {
    for (@s <- rootState) {
      new aCh in {
        authSubject!(*dId, *aCh) |
        for (@(true, who) <- aCh) {
          if (who != s.get("installer")) {
            rootState!(s) | ret!((false, "not installer"))
          } else {
            if (version < 1) {
              rootState!(s) | ret!((false, "bad version"))
            } else {
              match s.get("entries").get(key) {
                Nil => {
                  rootState!(s.set("entries", s.get("entries").set(key, {
                    "uri": uri, "version": version, "kind": kind }))) |
                  ret!((true, Nil))
                }
                _ => { rootState!(s) | ret!((false, "duplicate")) }
              }
            }
          }
        }
      }
    }
  } |

  authSubject!(*deployerId, *ackCh) |
  for (@(true, installer) <- ackCh) {
    rootState!({"installer": installer, "entries": {}}) |
    rs!(bundle+{*GenRoot}, *uriCh) |
    for (@uri <- uriCh) {
      GenRoot!("register", "component:root", uri, 1, "root", *deployerId, *ackCh2) |
      for (@r <- ackCh2) { deployId!([uri]) }
    }
  }
}
