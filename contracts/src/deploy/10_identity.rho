// Why: The REV address is the identity. A claim's participants must be authenticated subjects,
//      and the paper assumes identified practitioners. Identity creation is first-writer-wins.
// Paper: @robles2016nspe p.40 (records/identity); the identity concept is paper-adjacent.
// r-gen decision: one directory cell is the only deliberate identity-creation serialization
//      point; the hot-path claim/validation cells never touch it. No handles: a human-readable
//      handle registry is an extension, because handle uniqueness is inherently global.
// Placeholders: __ROOT_URI__.
new
  IdentityFactory, IdentityDirectory, directoryState,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, c1, c2, ack1, ack2, ack3,
  authOwner, authSubject, authPubKey, nowHeight
in {
  // @@INLINE:lib/Auth.rho@@
  // @@INLINE:lib/Time.rho@@

  contract IdentityDirectory(@"lookup", @address, ret) = {
    for (@s <<- directoryState) {
      match s.get("byAddress").get(address) {
        Nil => { ret!((false, "unknown")) }
        uri => { ret!((true, uri)) }
      }
    }
  } |

  contract IdentityDirectory(@"count", ret) = {
    for (@s <<- directoryState) {
      ret!((true, s.get("byAddress").size()))
    }
  } |

  contract IdentityFactory(@"create", dId, @profile, ret) = {
    new aCh, hCh in {
      authOwner!(*dId, *aCh) |
      nowHeight!(*hCh) |
      for (@(true, subject, pk) <- aCh; @height <- hCh) {
        for (@s <- directoryState) {
          match s.get("byAddress").get(subject) {
            Nil => {
              new identityState, Identity, uriCh in {
                identityState!({
                  "uri": "",
                  "subject": subject,
                  "pubKey": pk,
                  "handle": profile.get("handle"),
                  "displayNameHash": profile.get("displayNameHash"),
                  "orgHash": profile.get("orgHash"),
                  "contactHash": profile.get("contactHash"),
                  "status": "active",
                  "createdAt": height,
                  "updatedAt": height,
                  "version": 1
                }) |
                contract Identity(@"get", ret2) = {
                  for (@i <<- identityState) { ret2!((true, i)) }
                } |
                contract Identity(@"update", dId2, @patch, ret2) = {
                  new a2, h2 in {
                    authSubject!(*dId2, *a2) |
                    nowHeight!(*h2) |
                    for (@(true, who) <- a2; @now <- h2) {
                      for (@i <- identityState) {
                        if (who != subject) {
                          identityState!(i) | ret2!((false, "not owner"))
                        } else {
                          match i.set("displayNameHash", patch.get("displayNameHash"))
                                   .set("orgHash", patch.get("orgHash"))
                                   .set("contactHash", patch.get("contactHash"))
                                   .set("updatedAt", now)
                                   .set("version", i.get("version") + 1) {
                            i2 => { identityState!(i2) | ret2!((true, Nil)) }
                          }
                        }
                      }
                    }
                  }
                } |
                rs!(bundle+{*Identity}, *uriCh) |
                for (@uri <- uriCh) {
                  for (@i2 <- identityState) {
                    identityState!(i2.set("uri", uri))
                  } |
                  directoryState!(s.set("byAddress", s.get("byAddress").set(subject, uri))
                                   .set("version", s.get("version") + 1)) |
                  ret!((true, uri))
                }
              }
            }
            uri => { directoryState!(s) | ret!((false, "duplicate")) }
          }
        }
      }
    }
  } |

  directoryState!({"byAddress": {}, "version": 0}) |

  rs!(bundle+{*IdentityFactory}, *c1) |
  rs!(bundle+{*IdentityDirectory}, *c2) |
  for (@uFactory <- c1; @uDirectory <- c2) {
    rl!(`__ROOT_URI__`, *rootCh) |
    for (Root <- rootCh) {
      Root!("register", "component:identity-factory", uFactory, 1, "identity", *deployerId, *ack1) |
      Root!("register", "component:identity-directory", uDirectory, 1, "identity", *deployerId, *ack2) |
      for (@r1 <- ack1; @r2 <- ack2) {
        deployId!([("identity-factory", uFactory), ("identity-directory", uDirectory)])
      }
    }
  }
}
