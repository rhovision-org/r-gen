// The paper's clock is an agreed social schedule; the chain supplies the height that makes
// it enforceable. The kernel is native: no deployed Clock/Verifier contract is needed.

contract nowHeight(ret) = {
  new bd(`rho:block:data`), ch in {
    bd!(*ch) |
    for (@h, @sender, @timestamp <- ch) { ret!(h) }
  }
} |
