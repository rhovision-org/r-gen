// CredentialBook: issuers, credentials, scope matching and revocation.
// Placeholders: __ROOT_URI__, __ADMINS__, __THRESHOLD__, __GENESIS_ISSUER__.
new
  CredentialBook, credentialState,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, c, ack,
  adminGuard, resolveComponent, nowHeight,
  authOwner, authSubject, authPubKey, authIsOwner,
  listHas, listHasAny, listHas3, issuerCovers, issuerLive, credMatch,
  validScan, poolScan, activeScan
in {
contract resolveComponent(@key, ret) = {
  new rCh, Root, kCh in {
    rl!(`__ROOT_URI__`, *rCh) |
    for (Root <- rCh) {
      Root!("resolve", key, 1, *kCh) |
      for (@r <- kCh) {
        match r {
          (true, uri, _) => {
            new cCh in {
              rl!(uri, *cCh) |
              for (C <- cCh) { ret!((true, *C)) }
            }
          }
          _ => { ret!((false, "unavailable", key)) }
        }
      }
    }
  }
} |
// Deployer identity helpers. r-cash owns accounts; RGen uses the REV address as ownerId.

contract authOwner(dId, ret) = {
  new dops(`rho:rchain:deployerId:ops`), rev(`rho:rev:address`), pkCh, addrCh in {
    dops!("pubKeyBytes", *dId, *pkCh) |
    for (@pk <- pkCh) {
      rev!("fromPublicKey", pk, *addrCh) |
      for (@addr <- addrCh) { ret!((true, addr, pk)) }
    }
  }
} |

contract authSubject(dId, ret) = {
  new c in {
    authOwner!(*dId, *c) |
    for (@r <- c) {
      match r {
        (true, addr, _) => { ret!((true, addr)) }
        _ => { ret!((false, "no identity")) }
      }
    }
  }
} |

contract authPubKey(dId, ret) = {
  new c in {
    authOwner!(*dId, *c) |
    for (@r <- c) {
      match r {
        (true, _, pk) => { ret!((true, pk)) }
        _ => { ret!((false, "no identity")) }
      }
    }
  }
} |

contract authIsOwner(dId, @ownerId, ret) = {
  new c in {
    authSubject!(*dId, *c) |
    for (@r <- c) {
      match r {
        (true, addr) => {
          if (addr == ownerId) { ret!((true, Nil)) }
          else { ret!((false, "not owner")) }
        }
        _ => { ret!((false, "not owner")) }
      }
    }
  }
} |
// Resolve the deployed AdminGuard and verify one admin action.

contract adminGuard(@domain, @nonce, @action, @args, @sigs,
                    @admins, @threshold, ret) = {
  new rCh, Root, gCh, gc in {
    rl!(`__ROOT_URI__`, *rCh) |
    for (Root <- rCh) {
      Root!("resolve", "component:admin-guard", 1, *gCh) |
      for (@r <- gCh) {
        match r {
          (true, uri, _) => {
            rl!(uri, *gc) |
            for (AdminGuard <- gc) {
              AdminGuard!("verify", domain, nonce, action, args, sigs,
                          admins, threshold, *ret)
            }
          }
          _ => { ret!((false, "below threshold")) }
        }
      }
    }
  }
} |
// Block height helper for contracts that need an event height without resolving the Clock.

contract nowHeight(ret) = {
  new bd(`rho:block:data`), ch in {
    bd!(*ch) |
    for (@h, @sender, @timestamp <- ch) { ret!(h) }
  }
} |

  contract listHas(@list, @value, @i, ret) = {
    if (i >= list.length()) { ret!(false) }
    else {
      match list.nth(i) {
        x => {
          if (x == value) { ret!(true) }
          else { listHas!(list, value, i + 1, *ret) }
        }
      }
    }
  } |

  contract listHasAny(@list, @a, @b, @i, ret) = {
    if (i >= list.length()) { ret!(false) }
    else {
      match list.nth(i) {
        x => {
          if (x == a || x == b) { ret!(true) }
          else { listHasAny!(list, a, b, i + 1, *ret) }
        }
      }
    }
  } |

  contract listHas3(@list, @a, @b, @c, @i, ret) = {
    if (i >= list.length()) { ret!(false) }
    else {
      match list.nth(i) {
        x => {
          if (x == a || x == b || x == c) { ret!(true) }
          else { listHas3!(list, a, b, c, i + 1, *ret) }
        }
      }
    }
  } |

  contract issuerCovers(@rec, @ctype, @discipline, @jurisdiction, @role, @level, ret) = {
    new tCh, dCh, jCh, rCh in {
      listHasAny!(rec.get("types"), ctype, "*", 0, *tCh) |
      listHasAny!(rec.get("disciplines"), discipline, "*", 0, *dCh) |
      listHas3!(rec.get("jurisdictions"), jurisdiction, "global", "*", 0, *jCh) |
      listHasAny!(rec.get("roles"), role, "*", 0, *rCh) |
      for (@t <- tCh; @d <- dCh; @j <- jCh; @r <- rCh) {
        if (t && d && j && r && level <= rec.get("maxLevel")) { ret!(true) }
        else { ret!(false) }
      }
    }
  } |

  contract issuerLive(@rec, @atHeight, ret) = {
    if (rec.get("status") != "active") { ret!(false) }
    else {
      if (rec.get("expiresAt") == 0 || atHeight <= rec.get("expiresAt")) { ret!(true) }
      else { ret!(false) }
    }
  } |

  contract credMatch(@cred, @req, ret) = {
    match (cred.get("ctype"), cred.get("discipline"), cred.get("jurisdiction"),
           cred.get("role"), cred.get("level")) {
      (ctype, discipline, jurisdiction, role, level) => {
        if (ctype != req.get("ctype") && ctype != "*") { ret!(false) }
        else {
          if (discipline != req.get("discipline") && discipline != "*") { ret!(false) }
          else {
            if (jurisdiction != req.get("jurisdiction")
                && jurisdiction != "global" && jurisdiction != "*") { ret!(false) }
            else {
              if (role != req.get("role") && role != "*") { ret!(false) }
              else {
                if (level < req.get("minLevel")) { ret!(false) }
                else { ret!(true) }
              }
            }
          }
        }
      }
    }
  } |

  contract validScan(@ids, @i, @subject, @req, @atHeight, @s, ret) = {
    if (i >= ids.length()) {
      ret!((true, false, "not qualified"))
    } else {
      match ids.nth(i) {
        credId => {
          match s.get("credentials").get(credId) {
            Nil => { validScan!(ids, i + 1, subject, req, atHeight, s, *ret) }
            cred => {
              match s.get("issuers").get(cred.get("issuer")) {
                Nil => { validScan!(ids, i + 1, subject, req, atHeight, s, *ret) }
                issuerRec => {
                  new liveCh, matchCh in {
                    issuerLive!(issuerRec, atHeight, *liveCh) |
                    credMatch!(cred, req, *matchCh) |
                    for (@live <- liveCh; @m <- matchCh) {
                      if (cred.get("status") != "active") {
                        validScan!(ids, i + 1, subject, req, atHeight, s, *ret)
                      } else {
                        if (cred.get("expiresAt") != 0 && atHeight > cred.get("expiresAt")) {
                          validScan!(ids, i + 1, subject, req, atHeight, s, *ret)
                        } else {
                          if (live && m) { ret!((true, true, credId)) }
                          else { validScan!(ids, i + 1, subject, req, atHeight, s, *ret) }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract poolScan(@keys, @i, @req, @atHeight, @acc, ret) = {
    if (i >= keys.length()) {
      ret!((true, acc))
    } else {
      match keys.nth(i) {
        subject => {
          new vCh in {
            CredentialBook!("valid", subject, req, atHeight, *vCh) |
            for (@v <- vCh) {
              match v {
                (true, true, _) => { poolScan!(keys, i + 1, req, atHeight, acc ++ [subject], *ret) }
                _ => { poolScan!(keys, i + 1, req, atHeight, acc, *ret) }
              }
            }
          }
        }
      }
    }
  } |

  contract activeScan(@ids, @i, @discipline, @atHeight, @s, ret) = {
    if (i >= ids.length()) {
      ret!(false)
    } else {
      match ids.nth(i) {
        credId => {
          match s.get("credentials").get(credId) {
            Nil => { activeScan!(ids, i + 1, discipline, atHeight, s, *ret) }
            cred => {
              if (cred.get("status") == "active"
                  && (cred.get("expiresAt") == 0 || atHeight <= cred.get("expiresAt"))
                  && (cred.get("discipline") == discipline || cred.get("discipline") == "*")) {
                ret!(true)
              } else {
                activeScan!(ids, i + 1, discipline, atHeight, s, *ret)
              }
            }
          }
        }
      }
    }
  } |

  contract CredentialBook(@"issue", dId, @req, ret) = {
    new aCh, hCh in {
      authSubject!(dId, *aCh) |
      nowHeight!(*hCh) |
      for (@(true, issuer) <- aCh; @height <- hCh) {
        for (@s <- credentialState) {
          match s.get("issuers").get(issuer) {
            Nil => { credentialState!(s) | ret!((false, "unknown issuer")) }
            issuerRec => {
              if (issuerRec.get("status") != "active") {
                credentialState!(s) | ret!((false, "issuer revoked"))
              } else {
                match req.get("subject") {
                  Nil => { credentialState!(s) | ret!((false, "subject")) }
                  "" => { credentialState!(s) | ret!((false, "subject")) }
                  subject => {
                    if (subject == issuer) {
                      credentialState!(s) | ret!((false, "self issue"))
                    } else {
                      match req.get("level") {
                        level => {
                          if (level < 1 || level > 3) {
                            credentialState!(s) | ret!((false, "level"))
                          } else {
                            new covCh in {
                              issuerCovers!(issuerRec, req.get("ctype"), req.get("discipline"),
                                            req.get("jurisdiction"), req.get("role"), level,
                                            *covCh) |
                              for (@cov <- covCh) {
                                if (not cov) {
                                  credentialState!(s) | ret!((false, "not authorized"))
                                } else {
                                  match "cr:" ++ subject ++ ":" ++ req.get("ctype")
                                        ++ ":" ++ s.get("nonce").toString() {
                                    credId => {
                                      match s.get("credentials").get(credId) {
                                        Nil => {
                                          match s.get("subjectIndex").get(subject) {
                                            ids => {
                                              match s.set("credentials",
                                                s.get("credentials").set(credId, {
                                                  "subject": subject, "issuer": issuer,
                                                  "id": credId,
                                                  "ctype": req.get("ctype"),
                                                  "discipline": req.get("discipline"),
                                                  "jurisdiction": req.get("jurisdiction"),
                                                  "role": req.get("role"),
                                                  "level": level,
                                                  "evidenceHash": req.get("evidenceHash"),
                                                  "parent": req.get("parent"),
                                                  "issuedAt": height,
                                                  "expiresAt": req.get("expiresAt"),
                                                  "status": "active", "revokedAt": Nil,
                                                  "reason": Nil, "attestations": [],
                                                  "renewals": [] }))
                                                .set("subjectIndex",
                                                  s.get("subjectIndex").set(subject,
                                                    ids ++ [credId]))
                                                .set("nonce", s.get("nonce") + 1) {
                                                s2 => {
                                                  credentialState!(s2) |
                                                  ret!((true, credId))
                                                }
                                              }
                                            }
                                          }
                                        }
                                        _ => { credentialState!(s) | ret!((false, "duplicate")) }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract CredentialBook(@"renew", dId, @credId, @expiresAt, @evidenceHash, ret) = {
    new aCh, hCh in {
      authSubject!(dId, *aCh) |
      nowHeight!(*hCh) |
      for (@(true, who) <- aCh; @height <- hCh) {
        for (@s <- credentialState) {
          match s.get("credentials").get(credId) {
            Nil => { credentialState!(s) | ret!((false, "unknown credential")) }
            cred => {
              if (cred.get("issuer") != who) {
                credentialState!(s) | ret!((false, "not issuer"))
              } else {
                if (cred.get("status") != "active") {
                  credentialState!(s) | ret!((false, "not active"))
                } else {
                  match cred.set("expiresAt", expiresAt)
                             .set("renewals", cred.get("renewals") ++ [{
                               "at": height, "expiresAt": expiresAt,
                               "evidenceHash": evidenceHash }]) {
                    cred2 => {
                      credentialState!(s.set("credentials",
                        s.get("credentials").set(credId, cred2))) |
                      ret!((true, credId))
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract CredentialBook(@"revoke", dId, @credId, @reason, ret) = {
    new aCh, hCh in {
      authSubject!(dId, *aCh) |
      nowHeight!(*hCh) |
      for (@(true, who) <- aCh; @height <- hCh) {
        for (@s <- credentialState) {
          match s.get("credentials").get(credId) {
            Nil => { credentialState!(s) | ret!((false, "unknown credential")) }
            cred => {
              if (who != cred.get("issuer") && who != cred.get("subject")) {
                credentialState!(s) | ret!((false, "not authorized"))
              } else {
                if (cred.get("status") != "active") {
                  credentialState!(s) | ret!((false, "already revoked"))
                } else {
                  match cred.set("status", "revoked").set("revokedAt", height)
                             .set("reason", reason) {
                    cred2 => {
                      credentialState!(s.set("credentials",
                        s.get("credentials").set(credId, cred2))) |
                      ret!((true, Nil))
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract CredentialBook(@"attest", dId, @credId, @hash, ret) = {
    new aCh, hCh in {
      authSubject!(dId, *aCh) |
      nowHeight!(*hCh) |
      for (@(true, who) <- aCh; @height <- hCh) {
        for (@s <- credentialState) {
          match s.get("credentials").get(credId) {
            Nil => { credentialState!(s) | ret!((false, "unknown credential")) }
            cred => {
              if (who == cred.get("subject")) {
                credentialState!(s) | ret!((false, "self attest"))
              } else {
                match s.get("subjectIndex").get(who) {
                  Nil => { credentialState!(s) | ret!((false, "not qualified")) }
                  ids => {
                    new qCh in {
                      activeScan!(ids, 0, cred.get("discipline"), height, s, *qCh) |
                      for (@q <- qCh) {
                        if (not q) {
                          credentialState!(s) | ret!((false, "not qualified"))
                        } else {
                          match cred.set("attestations",
                            cred.get("attestations") ++ [{
                              "by": who, "hash": hash, "at": height }]) {
                            cred2 => {
                              credentialState!(s.set("credentials",
                                s.get("credentials").set(credId, cred2))) |
                              ret!((true, Nil))
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract CredentialBook(@"valid", @subject, @req, @atHeight, ret) = {
    for (@s <<- credentialState) {
      match s.get("subjectIndex").get(subject) {
        Nil => { ret!((false, "unknown")) }
        ids => { validScan!(ids, 0, subject, req, atHeight, s, *ret) }
      }
    }
  } |

  contract CredentialBook(@"pool", @req, ret) = {
    new hCh in {
      nowHeight!(*hCh) |
      for (@height <- hCh) {
        for (@s <<- credentialState) {
          poolScan!(s.get("subjectIndex").keys(), 0, req, height, [], *ret)
        }
      }
    }
  } |

  contract CredentialBook(@"creds", @subject, ret) = {
    for (@s <<- credentialState) {
      match s.get("subjectIndex").get(subject) {
        Nil => { ret!((true, [])) }
        ids => { ret!((true, ids)) }
      }
    }
  } |

  contract CredentialBook(@"credential", @credId, ret) = {
    for (@s <<- credentialState) {
      match s.get("credentials").get(credId) {
        Nil => { ret!((false, "unknown credential")) }
        rec => { ret!((true, rec)) }
      }
    }
  } |

  contract CredentialBook(@"issuer", @pk, ret) = {
    for (@s <<- credentialState) {
      match s.get("issuers").get(pk) {
        Nil => { ret!((false, "unknown issuer")) }
        rec => { ret!((true, rec)) }
      }
    }
  } |

  contract CredentialBook(@"issuers", ret) = {
    for (@s <<- credentialState) {
      ret!((true, s.get("issuers")))
    }
  } |

  contract CredentialBook(@"admin", @nonce, @action, @args, @sigs, ret) = {
    for (@s <- credentialState) {
      if (nonce <= s.get("govNonce")) {
        credentialState!(s) | ret!((false, "replay"))
      } else {
        new vCh in {
          adminGuard!("credentials", nonce, action, args, sigs,
                      s.get("admins"), s.get("threshold"), *vCh) |
          for (@v <- vCh) {
            match v {
              (true, ok) => {
                if (ok == false) {
                  credentialState!(s) | ret!((false, "below threshold"))
                } else {
                  match action {
                    "seedIssuer" => {
                      match args.nth(0) {
                        subject => {
                          credentialState!(s.set("issuers",
                            s.get("issuers").set(subject, {
                              "types": ["*"], "disciplines": ["*"], "jurisdictions": ["*"],
                              "roles": ["*"], "maxLevel": 3, "since": 0, "expiresAt": 0,
                              "status": "active" }))
                            .set("govNonce", nonce)) |
                          ret!((true, Nil))
                        }
                      }
                    }
                    "revokeIssuer" => {
                      match args.nth(0) {
                        subject => {
                          match s.get("issuers").get(subject) {
                            Nil => { credentialState!(s) | ret!((false, "unknown issuer")) }
                            rec => {
                              credentialState!(s.set("issuers",
                                s.get("issuers").set(subject, rec.set("status", "revoked")))
                                .set("govNonce", nonce)) |
                              ret!((true, Nil))
                            }
                          }
                        }
                      }
                    }
                    "setIssuers" => {
                      match args.nth(0) {
                        newIssuers => {
                          credentialState!(s.set("issuers", newIssuers)
                            .set("govNonce", nonce)) |
                          ret!((true, Nil))
                        }
                      }
                    }
                    "setAdmins" => {
                      match args.nth(0) {
                        newAdmins => {
                          match args.nth(1) {
                            newThreshold => {
                              if (newThreshold < 1 || newThreshold > newAdmins.length()) {
                                credentialState!(s) | ret!((false, "threshold"))
                              } else {
                                credentialState!(s.set("admins", newAdmins)
                                  .set("threshold", newThreshold)
                                  .set("govNonce", nonce)) |
                                ret!((true, Nil))
                              }
                            }
                          }
                        }
                      }
                    }
                    "setThreshold" => {
                      match args.nth(0) {
                        newThreshold => {
                          if (newThreshold < 1 || newThreshold > s.get("admins").length()) {
                            credentialState!(s) | ret!((false, "threshold"))
                          } else {
                            credentialState!(s.set("threshold", newThreshold)
                              .set("govNonce", nonce)) |
                            ret!((true, Nil))
                          }
                        }
                      }
                    }
                    _ => { credentialState!(s) | ret!((false, "unknown action")) }
                  }
                }
              }
              _ => { credentialState!(s) | ret!((false, "below threshold")) }
            }
          }
        }
      }
    }
  } |

  credentialState!({
    "issuers": {
      "__GENESIS_ISSUER__": {
        "types": ["*"], "disciplines": ["*"], "jurisdictions": ["*"],
        "roles": ["*"], "maxLevel": 3, "since": 0, "expiresAt": 0,
        "status": "active"
      }
    },
    "credentials": {
      "cr:genesis:issuer": {
        "id": "cr:genesis:issuer", "subject": "__GENESIS_ISSUER__",
        "issuer": "__GENESIS_ISSUER__", "ctype": "Issuer",
        "discipline": "*", "jurisdiction": "*", "role": "issuer", "level": 3,
        "evidenceHash": "", "parent": Nil, "issuedAt": 0, "expiresAt": 0,
        "status": "active", "revokedAt": Nil, "reason": Nil,
        "attestations": [], "renewals": []
      }
    },
    "subjectIndex": { "__GENESIS_ISSUER__": ["cr:genesis:issuer"] },
    "nonce": 1,
    "admins": __ADMINS__,
    "threshold": __THRESHOLD__,
    "govNonce": 0
  }) |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*CredentialBook}, *c) |
    for (@uri <- c) {
      Root!("register", "component:credential-book", uri, 1, "credentials",
            *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
