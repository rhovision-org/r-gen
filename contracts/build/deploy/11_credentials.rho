// Why: "Permissioned by Qualifications" (BIM p.7) and "validation of credentials should be in
//      place before validation of events" (Bridge p.6). A credential is a per-credential linear
//      cell; revocation is a single transition. The factory closes over the genuine genesis
//      Issuer, so a caller cannot substitute a fake issuer capability, and it keeps an issued
//      registry so a claim cannot be fooled by a forged credential.
// Paper: @mathews2017bim p.7; @zhong2019bridge p.6; @robles2016nspe p.25; @robles2016naic p.9
// r-gen decision: one genesis Issuer cell; issuer chains are a governance extension. The
//      factory registry is a deliberate issuance serialization point; validation reads do not
//      touch it.
// Placeholders: __ROOT_URI__.
new
  factoryState,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, issuerUriCh, factoryUriCh, ack1, ack2, ack3,
  authOwner, authSubject, authPubKey, nowHeight,
  listHas, listHasId, listHasAny, listHas3, minLevelOf, scopeMatches, issuerCovers
in {
// Deployer identity helpers. The REV address is the subject id; the public key is stored
// only where an identity profile needs it.

contract authOwner(dId, ret) = {
  new dops(`rho:rchain:deployerId:ops`), rev(`rho:rev:address`), pkCh, addrCh in {
    dops!("pubKeyBytes", *dId, *pkCh) |
    for (@pk <- pkCh) {
      rev!("fromPublicKey", pk, *addrCh) |
      for (@addr <- addrCh) { ret!((true, addr, pk)) }
    }
  }
} |

contract authSubject(dId, ret) = {
  new c in {
    authOwner!(*dId, *c) |
    for (@r <- c) {
      match r {
        (true, addr, _) => { ret!((true, addr)) }
        _ => { ret!((false, "no identity")) }
      }
    }
  }
} |

contract authPubKey(dId, ret) = {
  new c in {
    authOwner!(*dId, *c) |
    for (@r <- c) {
      match r {
        (true, _, pk) => { ret!((true, pk)) }
        _ => { ret!((false, "no identity")) }
      }
    }
  }
} |
// The paper's clock is an agreed social schedule; the chain supplies the height that makes
// it enforceable. The kernel is native: no deployed Clock/Verifier contract is needed.

contract nowHeight(ret) = {
  new bd(`rho:block:data`), ch in {
    bd!(*ch) |
    for (@h, @sender, @timestamp <- ch) { ret!(h) }
  }
} |
contract listHas(@list, @value, @i, ret) = {
  if (i >= list.length()) { ret!(false) }
  else {
    match list.nth(i) {
      x => {
        if (x == value) { ret!(true) }
        else { listHas!(list, value, i + 1, *ret) }
      }
    }
  }
} |

contract listHasId(@list, @id, @i, ret) = {
  if (i >= list.length()) { ret!(false) }
  else {
    match list.nth(i) {
      x => {
        if (x.get("id") == id) { ret!(true) }
        else { listHasId!(list, id, i + 1, *ret) }
      }
    }
  }
} |

contract listHasAny(@list, @a, @b, @i, ret) = {
  if (i >= list.length()) { ret!(false) }
  else {
    match list.nth(i) {
      x => {
        if (x == a || x == b) { ret!(true) }
        else { listHasAny!(list, a, b, i + 1, *ret) }
      }
    }
  }
} |

contract listHas3(@list, @a, @b, @c, @i, ret) = {
  if (i >= list.length()) { ret!(false) }
  else {
    match list.nth(i) {
      x => {
        if (x == a || x == b || x == c) { ret!(true) }
        else { listHas3!(list, a, b, c, i + 1, *ret) }
      }
    }
  }
} |
// Scope matching for credentials and issuers. The papers require that validators are
// themselves validated; the scope is the concrete form of "qualified for this event".

contract minLevelOf(@req, ret) = {
  match req.get("minLevel") {
    Nil => { ret!(0) }
    ml => { ret!(ml) }
  }
} |

contract scopeMatches(@cred, @req, ret) = {
  new mlCh in {
    minLevelOf!(req, *mlCh) |
    for (@ml <- mlCh) {
      match (cred.get("ctype"), cred.get("discipline"), cred.get("jurisdiction"),
             cred.get("role"), cred.get("level")) {
        (ctype, discipline, jurisdiction, role, level) => {
          if (ctype != req.get("ctype") && ctype != "*") { ret!(false) }
          else {
            if (discipline != req.get("discipline") && discipline != "*") { ret!(false) }
            else {
              if (jurisdiction != req.get("jurisdiction")
                  && jurisdiction != "global" && jurisdiction != "*") { ret!(false) }
              else {
                if (role != req.get("role") && role != "*") { ret!(false) }
                else {
                  if (level < ml) { ret!(false) }
                  else { ret!(true) }
                }
              }
            }
          }
        }
      }
    }
  }
} |

contract issuerCovers(@issuer, @req, ret) = {
  new tCh, dCh, jCh, rCh, mlCh in {
    listHasAny!(issuer.get("types"), req.get("ctype"), "*", 0, *tCh) |
    listHasAny!(issuer.get("disciplines"), req.get("discipline"), "*", 0, *dCh) |
    listHas3!(issuer.get("jurisdictions"), req.get("jurisdiction"), "global", "*", 0, *jCh) |
    listHasAny!(issuer.get("roles"), req.get("role"), "*", 0, *rCh) |
    minLevelOf!(req, *mlCh) |
    for (@t <- tCh; @d <- dCh; @j <- jCh; @r <- rCh; @ml <- mlCh) {
      if (t && d && j && r && ml <= issuer.get("maxLevel")) { ret!(true) }
      else { ret!(false) }
    }
  }
} |

  factoryState!({"issued": {}, "version": 0}) |

  authSubject!(*deployerId, *ack1) |
  for (@(true, genesis) <- ack1) {
    new Issuer, CredentialFactory, issuerState in {
      issuerState!({
        "subject": genesis,
        "types": ["*"],
        "disciplines": ["*"],
        "jurisdictions": ["*"],
        "roles": ["*"],
        "maxLevel": 3,
        "status": "active",
        "expiresAt": 0,
        "revokedAt": Nil,
        "createdAt": 0,
        "version": 1
      }) |

      contract Issuer(@"get", ret) = {
        for (@s <<- issuerState) { ret!((true, s)) }
      } |

      contract Issuer(@"authorize", @caller, @req, @atHeight, ret) = {
        for (@s <<- issuerState) {
          if (caller != s.get("subject")) { ret!((true, false, "not issuer")) }
          else {
            if (s.get("status") != "active") { ret!((true, false, "issuer revoked")) }
            else {
              if (s.get("expiresAt") != 0 && atHeight > s.get("expiresAt")) {
                ret!((true, false, "issuer expired"))
              } else {
                new c in {
                  issuerCovers!(s, req, *c) |
                  for (@ok <- c) {
                    if (ok) { ret!((true, true)) }
                    else { ret!((true, false, "issuer scope")) }
                  }
                }
              }
            }
          }
        }
      } |

      contract Issuer(@"covers", @req, @atHeight, ret) = {
        for (@s <<- issuerState) {
          if (s.get("status") != "active") {
            ret!((true, false, "issuer revoked"))
          } else {
            if (s.get("expiresAt") != 0 && atHeight > s.get("expiresAt")) {
              ret!((true, false, "issuer expired"))
            } else {
              new c in {
                issuerCovers!(s, req, *c) |
                for (@ok <- c) { ret!((true, ok)) }
              }
            }
          }
        }
      } |

      contract CredentialFactory(@"verify", @uri, ret) = {
        for (@s <<- factoryState) {
          match s.get("issued").get(uri.toString()) {
            Nil => { ret!((false, "unknown credential")) }
            rec => { ret!((true, rec)) }
          }
        }
      } |

      contract CredentialFactory(@"count", ret) = {
        for (@s <<- factoryState) { ret!((true, s.get("issued").size())) }
      } |

      contract CredentialFactory(@"issue", dId, @req, ret) = {
        new aCh, hCh in {
          authSubject!(*dId, *aCh) |
          nowHeight!(*hCh) |
          for (@(true, issuer) <- aCh; @height <- hCh) {
            new authCh in {
              Issuer!("authorize", issuer, req.set("minLevel", req.get("level")), height, *authCh) |
              for (@a <- authCh) {
                match a {
                  (true, true) => {
                    for (@s <- factoryState) {
                      if (req.get("subject") == issuer) {
                        factoryState!(s) | ret!((false, "self issue"))
                      } else {
                      new credState, Credential, uriCh in {
                        credState!({
                          "uri": "",
                          "subject": req.get("subject"),
                          "issuer": issuer,
                          "issuerUri": req.get("issuerUri"),
                          "ctype": req.get("ctype"),
                          "discipline": req.get("discipline"),
                          "jurisdiction": req.get("jurisdiction"),
                          "role": req.get("role"),
                          "level": req.get("level"),
                          "evidenceHash": req.get("evidenceHash"),
                          "issuedAt": height,
                          "expiresAt": req.get("expiresAt"),
                          "status": "active",
                          "revokedAt": Nil,
                          "reason": Nil,
                          "attestations": [],
                          "renewals": [],
                          "version": 1
                        }) |
                        contract Credential(@"get", ret2) = {
                          for (@cs <<- credState) { ret2!((true, cs)) }
                        } |
                        contract Credential(@"check", @caller, @rq, @atHeight, ret2) = {
                          for (@cs <<- credState) {
                            if (caller != cs.get("subject")) {
                              ret2!((true, false, "not subject"))
                            } else {
                              if (cs.get("status") != "active") {
                                ret2!((true, false, "revoked"))
                              } else {
                                if (cs.get("expiresAt") != 0
                                    && atHeight > cs.get("expiresAt")) {
                                  ret2!((true, false, "expired"))
                                } else {
                                  new smCh, isCh in {
                                    scopeMatches!(cs, rq, *smCh) |
                                    Issuer!("covers", rq, atHeight, *isCh) |
                                    for (@sm <- smCh; @isr <- isCh) {
                                      match isr {
                                        (true, true) => {
                                          if (sm) { ret2!((true, true, cs.get("uri"))) }
                                          else { ret2!((true, false, "scope")) }
                                        }
                                        _ => { ret2!((true, false, "issuer")) }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        } |
                        contract Credential(@"prove", dId2, @rq, ret2) = {
                          new a2, h2 in {
                            authSubject!(*dId2, *a2) |
                            nowHeight!(*h2) |
                            for (@(true, who) <- a2; @height <- h2) {
                              for (@cs <- credState) {
                                if (who != cs.get("subject")) {
                                  credState!(cs) | ret2!((false, "not subject"))
                                } else {
                                  if (cs.get("status") != "active") {
                                    credState!(cs) | ret2!((false, "revoked"))
                                  } else {
                                    if (cs.get("expiresAt") != 0
                                        && height > cs.get("expiresAt")) {
                                      credState!(cs) | ret2!((false, "expired"))
                                    } else {
                                      new smCh, isCh in {
                                        scopeMatches!(cs, rq, *smCh) |
                                        Issuer!("covers", rq, height, *isCh) |
                                        for (@sm <- smCh; @isr <- isCh) {
                                          match isr {
                                            (true, true) => {
                                              if (sm) {
                                                new proofState, Proof, proofUriCh in {
                                                  proofState!({
                                                    "data": {
                                                      "uri": "proof:" ++ cs.get("uri").toString() ++ ":" ++ height.toString(),
                                                      "subject": cs.get("subject"),
                                                      "requirement": rq,
                                                      "atHeight": height,
                                                      "level": cs.get("level"),
                                                      "credentialUri": cs.get("uri").toString()
                                                    },
                                                    "used": false
                                                  }) |
                                                  contract Proof(@"take", ret3) = {
                                                    for (@p <- proofState) {
                                                      if (p.get("used")) {
                                                        proofState!(p) | ret3!((false, "used"))
                                                      } else {
                                                        proofState!(p.set("used", true)) |
                                                        ret3!((true, p.get("data")))
                                                      }
                                                    }
                                                  } |
                                                  rs!(bundle+{*Proof}, *proofUriCh) |
                                                  for (@proofUri <- proofUriCh) {
                                                    credState!(cs) |
                                                    ret2!((true, proofUri))
                                                  }
                                                }
                                              } else { credState!(cs) | ret2!((false, "scope")) }
                                            }
                                            _ => { credState!(cs) | ret2!((false, "issuer")) }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        } |

                        contract Credential(@"revoke", dId2, @reason, ret2) = {
                          new a2, h2 in {
                            authSubject!(*dId2, *a2) |
                            nowHeight!(*h2) |
                            for (@(true, who) <- a2; @now <- h2) {
                              for (@cs <- credState) {
                                if (who != cs.get("issuer") && who != cs.get("subject")) {
                                  credState!(cs) | ret2!((false, "not authorized"))
                                } else {
                                  if (cs.get("status") != "active") {
                                    credState!(cs) | ret2!((false, "already revoked"))
                                  } else {
                                    credState!(cs.set("status", "revoked")
                                                 .set("revokedAt", now)
                                                 .set("reason", reason)
                                                 .set("version", cs.get("version") + 1)) |
                                    ret2!((true, Nil))
                                  }
                                }
                              }
                            }
                          }
                        } |
                        contract Credential(@"renew", dId2, @expiresAt, @evidenceHash, ret2) = {
                          new a2, h2 in {
                            authSubject!(*dId2, *a2) |
                            nowHeight!(*h2) |
                            for (@(true, who) <- a2; @now <- h2) {
                              for (@cs <- credState) {
                                if (who != cs.get("issuer")) {
                                  credState!(cs) | ret2!((false, "not issuer"))
                                } else {
                                  if (cs.get("status") != "active") {
                                    credState!(cs) | ret2!((false, "not active"))
                                  } else {
                                    credState!(cs.set("expiresAt", expiresAt)
                                                 .set("renewals", cs.get("renewals") ++ [{
                                                   "at": now, "expiresAt": expiresAt,
                                                   "evidenceHash": evidenceHash }])
                                                 .set("version", cs.get("version") + 1)) |
                                    ret2!((true, Nil))
                                  }
                                }
                              }
                            }
                          }
                        } |
                        contract Credential(@"attest", dId2, @hash, ret2) = {
                          new a2, h2 in {
                            authSubject!(*dId2, *a2) |
                            nowHeight!(*h2) |
                            for (@(true, who) <- a2; @now <- h2) {
                              for (@cs <- credState) {
                                if (who == cs.get("subject")) {
                                  credState!(cs) | ret2!((false, "self attest"))
                                } else {
                                  new dupCh in {
                                    listHasId!(cs.get("attestations"), who, 0, *dupCh) |
                                    for (@dup <- dupCh) {
                                      if (dup) {
                                        credState!(cs) | ret2!((false, "already attested"))
                                      } else {
                                        credState!(cs.set("attestations",
                                          cs.get("attestations") ++ [{"id": who, "by": who,
                                                                       "hash": hash, "at": now}])
                                          .set("version", cs.get("version") + 1)) |
                                        ret2!((true, Nil))
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        } |
                        rs!(bundle+{*Credential}, *uriCh) |
                        for (@uri <- uriCh) {
                          for (@cs2 <- credState) { credState!(cs2.set("uri", uri)) } |
                          factoryState!(s.set("issued", s.get("issued").set(uri.toString(), {
                            "issuer": issuer,
                            "subject": req.get("subject"),
                            "ctype": req.get("ctype"),
                            "discipline": req.get("discipline"),
                            "jurisdiction": req.get("jurisdiction"),
                            "role": req.get("role"),
                            "level": req.get("level")}))
                            .set("version", s.get("version") + 1)) |
                          ret!((true, uri))
                        }
                      }
                      }
                    }
                  }
                  _ => { ret!(a) }
                }
              }
            }
          }
        }
      } |

      rs!(bundle+{*Issuer}, *issuerUriCh) |
      rs!(bundle+{*CredentialFactory}, *factoryUriCh) |
      for (@issuerUri <- issuerUriCh; @factoryUri <- factoryUriCh) {
        rl!(`__ROOT_URI__`, *rootCh) |
        for (Root <- rootCh) {
          Root!("register", "component:issuer", issuerUri, 1, "credentials",
                *deployerId, *ack2) |
          Root!("register", "component:credential-factory", factoryUri, 1, "credentials",
                *deployerId, *ack3) |
          for (@r1 <- ack2; @r2 <- ack3) {
            deployId!([("issuer", issuerUri), ("credential-factory", factoryUri)])
          }
        }
      }
    }
  }
}
