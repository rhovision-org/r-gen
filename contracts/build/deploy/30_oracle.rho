// Why: NSPE p.25 / NAIC p.9 / BIM p.8 name a singular "most appropriate person" adjudicator.
//      A per-case linear cell makes a second decision or a second execution non-representable.
//      The case holds the subject's private applyDecision capability, never a subject id the
//      caller can substitute, so a decision cannot be applied to another K-Asset.
// Paper: @robles2016nspe p.25; @robles2016naic p.9; @mathews2017bim p.8.
// r-gen decision: single adjudicator in core; panels/votes/tally are an extension. Selection is
//      deterministic and named by the parties, not a random beacon.
// Placeholders: __ROOT_URI__, __CREDENTIAL_FACTORY_URI__.
new
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, cfCh, cFactory, ack1,
  authOwner, authSubject, authPubKey, nowHeight,
  listHas, listHasId, listHasAny, listHas3,
  CredentialFactory, openCaseCheck, caseReqOk, outcomeStatus, resolveAndProve, checkCredentialProof, proveAndCheck, checkValidatedProof, resolveProveValidated, proveValidatedAndCheck
in {
// Deployer identity helpers. The REV address is the subject id; the public key is stored
// only where an identity profile needs it.

contract authOwner(dId, ret) = {
  new dops(`rho:rchain:deployerId:ops`), rev(`rho:rev:address`), pkCh, addrCh in {
    dops!("pubKeyBytes", *dId, *pkCh) |
    for (@pk <- pkCh) {
      rev!("fromPublicKey", pk, *addrCh) |
      for (@addr <- addrCh) { ret!((true, addr, pk)) }
    }
  }
} |

contract authSubject(dId, ret) = {
  new c in {
    authOwner!(*dId, *c) |
    for (@r <- c) {
      match r {
        (true, addr, _) => { ret!((true, addr)) }
        _ => { ret!((false, "no identity")) }
      }
    }
  }
} |

contract authPubKey(dId, ret) = {
  new c in {
    authOwner!(*dId, *c) |
    for (@r <- c) {
      match r {
        (true, _, pk) => { ret!((true, pk)) }
        _ => { ret!((false, "no identity")) }
      }
    }
  }
} |
// The paper's clock is an agreed social schedule; the chain supplies the height that makes
// it enforceable. The kernel is native: no deployed Clock/Verifier contract is needed.

contract nowHeight(ret) = {
  new bd(`rho:block:data`), ch in {
    bd!(*ch) |
    for (@h, _, _ <- ch) { ret!(h) }
  }
} |
contract listHas(@list, @value, @i, ret) = {
  if (i >= list.length()) { ret!(false) }
  else {
    match list.nth(i) {
      x => {
        if (x == value) { ret!(true) }
        else { listHas!(list, value, i + 1, *ret) }
      }
    }
  }
} |

contract listHasId(@list, @id, @i, ret) = {
  if (i >= list.length()) { ret!(false) }
  else {
    match list.nth(i) {
      x => {
        if (x.get("id") == id) { ret!(true) }
        else { listHasId!(list, id, i + 1, *ret) }
      }
    }
  }
} |

contract listHasAny(@list, @a, @b, @i, ret) = {
  if (i >= list.length()) { ret!(false) }
  else {
    match list.nth(i) {
      x => {
        if (x == a || x == b) { ret!(true) }
        else { listHasAny!(list, a, b, i + 1, *ret) }
      }
    }
  }
} |

contract listHas3(@list, @a, @b, @c, @i, ret) = {
  if (i >= list.length()) { ret!(false) }
  else {
    match list.nth(i) {
      x => {
        if (x == a || x == b || x == c) { ret!(true) }
        else { listHas3!(list, a, b, c, i + 1, *ret) }
      }
    }
  }
} |
// One-shot proof helpers. A credential or value proposition `prove` arm returns a private
// `Proof` capability on a caller-supplied channel; every `prove` variant sends
// `bundle+{*Proof}` on that channel and returns `(true, Nil)`. The proof is never inserted into
// the registry, so there is no discoverable proof URI for a third party to burn. `take` yields
// `(true, data)` once and `(false, "used")` after that.
//
// These helpers resolve the credential or value proposition by its registry URI, receive the
// private proof capability, take it, and check the fields the caller binds. The capability is
// bound directly in a receive pattern; it is never passed through a data tuple.

contract checkCredentialProof(Proof, @validator, @credentialUri, @height, ret) = {
  new tCh in {
    Proof!("take", *tCh) |
    for (@t <- tCh) {
      match t {
        (true, data) => {
          if (data.get("subject") == validator
              && data.get("credentialUri") == credentialUri
              && data.get("atHeight") == height) { ret!(true) }
          else { ret!(false) }
        }
        _ => { ret!(false) }
      }
    }
  }
} |

contract proveAndCheck(@credentialUri, dId, @rq, @validator, @height, ret) = {
  new credCh, proofCh, okCh in {
    rl!(credentialUri, *credCh) |
    for (Credential <- credCh) {
      new statusCh in {
        Credential!("prove", *dId, rq, *statusCh, *proofCh) |
        for (@s <- statusCh) {
          match s {
            (true, _) => {
              for (Proof <- proofCh) {
                checkCredentialProof!(*Proof, validator, credentialUri, height, *okCh) |
                for (@ok <- okCh) { ret!(ok) }
              }
            }
            _ => { ret!(false) }
          }
        }
      }
    }
  }
} |

contract checkValidatedProof(Proof, @caller, @atHeight, ret) = {
  new tCh in {
    Proof!("take", *tCh) |
    for (@t <- tCh) {
      match t {
        (true, data) => {
          if (data.get("caller") == caller && data.get("atHeight") == atHeight) {
            ret!(true)
          } else { ret!(false) }
        }
        _ => { ret!(false) }
      }
    }
  }
} |

contract proveValidatedAndCheck(@vpUri, dId, @caller, @atHeight, ret) = {
  new vpc, proofCh, okCh in {
    rl!(vpUri, *vpc) |
    for (VP <- vpc) {
      new statusCh in {
        VP!("proveValidated", *dId, atHeight, *statusCh, *proofCh) |
        for (@s <- statusCh) {
          match s {
            (true, _) => {
              for (Proof <- proofCh) {
                checkValidatedProof!(*Proof, caller, atHeight, *okCh) |
                for (@ok <- okCh) { ret!(ok) }
              }
            }
            _ => { ret!(false) }
          }
        }
      }
    }
  }
} |
// One outcome-to-status table. The K-Asset and value-proposition applyDecision arms use the
// same mapping; keeping it in one helper stops the two copies from drifting. An unknown
// outcome returns Nil, which the caller turns into an explicit refusal.

contract outcomeStatus(@outcome, ret) = {
  match outcome {
    "uphold" => { ret!("upheld") }
    "revoke" => { ret!("revoked") }
    "partial" => { ret!("partially_revoked") }
    _ => { ret!(Nil) }
  }
} |

  rl!(`__CREDENTIAL_FACTORY_URI__`, *cfCh) |
  for (CredentialFactory <- cfCh) {
    new OracleFactory in {
      contract openCaseCheck(@caseReq, ret) = {
        new vfCh in {
          CredentialFactory!("verify", caseReq.get("adjudicatorCredentialUri"), *vfCh) |
          for (@vf <- vfCh) {
            match vf {
              (true, _) => {
                new ccCh in {
                  rl!(caseReq.get("adjudicatorCredentialUri"), *ccCh) |
                  for (Credential <- ccCh) {
                    new gCh in {
                      Credential!("get", *gCh) |
                      for (@g <- gCh) {
                        match g {
                          (true, cred) => {
                            if (cred.get("subject") == caseReq.get("adjudicator")) { ret!(true) }
                            else { ret!(false) }
                          }
                          _ => { ret!(false) }
                        }
                      }
                    }
                  }
                }
              }
              _ => { ret!(false) }
            }
          }
        }
      } |

      contract caseReqOk(@caseReq, @opener, @now, ret) = {
        new pCh, aCh in {
          match (caseReq.get("deadlineHeight"), caseReq.get("kind"),
                 caseReq.get("parties"), caseReq.get("adjudicator")) {
            (deadline, kind, parties, adjudicator) => {
              if (deadline == Nil || deadline <= now
                  || kind == Nil || kind == ""
                  || parties == Nil || parties.length() == 0) { ret!(false) }
              else {
                listHas!(parties, opener, 0, *pCh) |
                listHas!(parties, adjudicator, 0, *aCh) |
                for (@isParty <- pCh; @isAdj <- aCh) {
                  if (not isParty || isAdj) { ret!(false) }
                  else { ret!(true) }
                }
              }
            }
          }
        }
      } |

      contract OracleFactory(@"open", dId, @subjectRef, @caseReq, subjectApply, ret) = {
        new aCh, okCh, hCh in {
        authSubject!(*dId, *aCh) |
        openCaseCheck!(caseReq, *okCh) |
        nowHeight!(*hCh) |
        for (@(true, opener) <- aCh; @ok <- okCh; @now <- hCh) {
        if (opener != caseReq.get("openedBy")) { ret!((false, "not opener")) }
        else if (subjectRef == Nil) { ret!((false, "case fields")) }
        else {
        new ckCh in {
        caseReqOk!(caseReq, opener, now, *ckCh) |
        for (@caseOk <- ckCh) {
        if (not caseOk) { ret!((false, "case fields")) }
        else if (not ok) { ret!((false, "adjudicator credential")) }
        else {
        new caseState, OracleCase, selfDecide, commitExecution, uriCh in {
          caseState!({
            "uri": "",
            "kind": caseReq.get("kind"),
            "subjectRef": subjectRef,
            "openedBy": caseReq.get("openedBy"),
            "parties": caseReq.get("parties"),
            "groundsHash": caseReq.get("groundsHash"),
            "requirement": caseReq.get("requirement"),
            "adjudicator": caseReq.get("adjudicator"),
            "adjudicatorCredentialUri": caseReq.get("adjudicatorCredentialUri"),
            "evidence": [],
            "status": "open",
            "decision": Nil,
            "deadlineHeight": caseReq.get("deadlineHeight"),
            "execution": Nil,
            "version": 1
          }) |

          contract OracleCase(@"get", ret2) = {
            for (@s <<- caseState) { ret2!((true, s)) }
          } |

          contract OracleCase(@"evidence", dId, @ev, ret2) = {
            new aCh, hCh in {
              authSubject!(*dId, *aCh) |
              nowHeight!(*hCh) |
              for (@(true, who) <- aCh; @now <- hCh) {
                for (@s <- caseState) {
                  if (s.get("status") != "open") {
                    caseState!(s) | ret2!((false, "not open"))
                  } else {
                    new partyCh in {
                      listHas!(s.get("parties"), who, 0, *partyCh) |
                      for (@party <- partyCh) {
                        if ((not party) && who != s.get("adjudicator")) {
                          caseState!(s) | ret2!((false, "not a party"))
                        } else {
                          caseState!(s.set("evidence", s.get("evidence") ++ [{
                            "by": who, "hash": ev.get("hash"), "at": now}])
                            .set("version", s.get("version") + 1)) |
                          ret2!((true, Nil))
                        }
                      }
                    }
                  }
                }
              }
            }
          } |

          contract OracleCase(@"decide", dId, @decision, ret2) = {
            new aCh, hCh in {
              authSubject!(*dId, *aCh) |
              nowHeight!(*hCh) |
              for (@(true, who) <- aCh; @now <- hCh) {
                for (@s <- caseState) {
                  match (s.get("status") == "open", who == s.get("adjudicator"),
                         now > s.get("deadlineHeight")) {
                    (true, true, false) => {
                      new okCh in {
                        proveAndCheck!(s.get("adjudicatorCredentialUri"), *dId,
                          s.get("requirement"), who, now, *okCh) |
                        new osCh in {
                          outcomeStatus!(decision.get("outcome"), *osCh) |
                          for (@ok <- okCh; @target <- osCh) {
                            match (ok, target) {
                              (true, Nil) => { caseState!(s) | ret2!((false, "outcome")) }
                              (true, _) => { selfDecide!(s, decision, now, *ret2) }
                              (false, _) => { caseState!(s) | ret2!((false, "not qualified")) }
                              _ => { caseState!(s) | ret2!((false, "outcome")) }
                            }
                          }
                        }
                      }
                    }
                    (true, false, false) => { caseState!(s) | ret2!((false, "not adjudicator")) }
                    (true, _, true) => { caseState!(s) | ret2!((false, "expired")) }
                    (false, _, _) => { caseState!(s) | ret2!((false, "not open")) }
                    _ => { caseState!(s) | ret2!((false, "not adjudicator")) }
                  }
                }
              }
            }
          } |

          contract selfDecide(@s, @decision, @now, ret2) = {
            caseState!(s.set("status", "decided")
                        .set("decision", decision.set("decidedAt", now))
                        .set("version", s.get("version") + 1)) |
            ret2!((true, Nil))
          } |

          contract commitExecution(@s, @status, @execStatus, @lastError, @outcome,
                                   @reply, ret2) = {
            for (@s2 <- caseState) {
              caseState!(s2.set("status", status)
                           .set("execution", {"attempts": 1,
                                              "lastError": lastError,
                                              "status": execStatus,
                                              "caseId": s.get("uri"),
                                              "decision": s.get("decision"),
                                              "outcome": outcome}))
            } |
            ret2!(reply)
          } |

          contract OracleCase(@"execute", ret2) = {
            for (@s <- caseState) {
              if (s.get("status") == "executed") {
                caseState!(s) | ret2!((true, "already executed"))
              } else {
                if (s.get("status") != "decided" && s.get("status") != "executing") {
                  caseState!(s) | ret2!((false, "not decided"))
                } else {
                  caseState!(s.set("status", "executing")
                              .set("execution", {"attempts": 1, "lastError": Nil,
                                                 "status": "pending",
                                                 "caseId": s.get("uri"),
                                                 "decision": s.get("decision")})) |
                  new aCh in {
                    subjectApply!("applyDecision", s.get("uri"), s.get("decision"), *aCh) |
                    for (@a <- aCh) {
                      match a {
                        (true, outcome) => {
                          commitExecution!(s, "executed", "applied", Nil, outcome,
                                           (true, outcome), *ret2)
                        }
                        (false, why) => {
                          commitExecution!(s, "decided", "failed", why, Nil,
                                           (false, why), *ret2)
                        }
                        _ => {
                          commitExecution!(s, "decided", "failed", "apply", Nil,
                                           (false, "apply"), *ret2)
                        }
                      }
                    }
                  }
                }
              }
            }
          } |

          contract OracleCase(@"expire", ret2) = {
            new hCh in {
              nowHeight!(*hCh) |
              for (@now <- hCh) {
                for (@s <- caseState) {
                  if (s.get("status") != "open") {
                    caseState!(s) | ret2!((false, "not open"))
                  } else {
                    if (now <= s.get("deadlineHeight")) {
                      caseState!(s) | ret2!((false, "not expired"))
                    } else {
                      caseState!(s.set("status", "expired")
                                  .set("version", s.get("version") + 1)) |
                      ret2!((true, Nil))
                    }
                  }
                }
              }
            }
          } |

          contract OracleCase(@"close", ret2) = {
            for (@s <- caseState) {
              if (s.get("status") != "executed" && s.get("status") != "expired") {
                caseState!(s) | ret2!((false, "not finished"))
              } else {
                caseState!(s.set("status", "closed")
                            .set("version", s.get("version") + 1)) |
                ret2!((true, Nil))
              }
            }
          } |

          rs!(bundle+{*OracleCase}, *uriCh) |
          for (@uri <- uriCh) {
            for (@s2 <- caseState) { caseState!(s2.set("uri", uri)) } |
            ret!((true, {"id": uri, "uri": uri}))
          }
        }
        }
        }
        }
        }
        }
        }
      } |

      rs!(bundle+{*OracleFactory}, *cFactory) |
      for (@uri <- cFactory) {
        rl!(`__ROOT_URI__`, *rootCh) |
        for (Root <- rootCh) {
          Root!("register", "component:oracle-factory", uri, 1, "oracle",
                *deployerId, *ack1) |
          for (@r <- ack1) { deployId!([("oracle-factory", uri)]) }
        }
      }
    }
  }
}
