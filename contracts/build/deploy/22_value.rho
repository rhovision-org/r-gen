// Why: BIM p.7/p.9 names a "new value proposition" that captures intrinsic intangible value.
//      The papers do not define a value-proposition state machine, so this is a user-requested
//      first-class primitive: a proposition cell, validated by a qualified subject, composable
//      with a claim or K-Asset by reference.
// Paper: @mathews2017bim p.7, p.9 (paper-adjacent phrase); user decision (separate primitive).
// r-gen decision: per-VP linear cell; one validation transition; dispute applies only through a
//      private capability held by the oracle case.
// Placeholders: __ROOT_URI__, __CREDENTIAL_FACTORY_URI__, __ORACLE_FACTORY_URI__.
new
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, cfCh, ofCh, cFactory, ack1,
  authOwner, authSubject, authPubKey, nowHeight,
  CredentialFactory, OracleFactory,
  vpReqOk, outcomeStatus,
  checkCredentialProof, proveAndCheck, checkValidatedProof, proveValidatedAndCheck,
  proveAndCheckCall, proveAndCheckReply, proveTakeAndCheck,
  proveValidatedCall, proveValidatedReply, proveValidatedTake
in {
// Deployer identity helpers. The REV address is the subject id; the public key is stored
// only where an identity profile needs it.

contract authOwner(dId, ret) = {
  new dops(`rho:rchain:deployerId:ops`), rev(`rho:rev:address`), pkCh, addrCh in {
    dops!("pubKeyBytes", *dId, *pkCh) |
    for (@pk <- pkCh) {
      rev!("fromPublicKey", pk, *addrCh) |
      for (@addr <- addrCh) { ret!((true, addr, pk)) }
    }
  }
} |

contract authSubject(dId, ret) = {
  new c in {
    authOwner!(*dId, *c) |
    for (@r <- c) {
      match r {
        (true, addr, _) => { ret!((true, addr)) }
        _ => { ret!((false, "no identity")) }
      }
    }
  }
} |

contract authPubKey(dId, ret) = {
  new c in {
    authOwner!(*dId, *c) |
    for (@r <- c) {
      match r {
        (true, _, pk) => { ret!((true, pk)) }
        _ => { ret!((false, "no identity")) }
      }
    }
  }
} |
// The paper's clock is an agreed social schedule; the chain supplies the height that makes
// it enforceable. The kernel is native: no deployed Clock/Verifier contract is needed.

contract nowHeight(ret) = {
  new bd(`rho:block:data`), ch in {
    bd!(*ch) |
    for (@h, _, _ <- ch) { ret!(h) }
  }
} |
// One-shot proof helpers. A credential or value proposition `prove` arm returns a private
// `Proof` capability on a caller-supplied channel; every `prove` variant sends
// `bundle+{*Proof}` on that channel and returns `(true, Nil)`. The proof is never inserted
// into the registry, so there is no discoverable proof URI for a third party to burn.
// `take` yields `(true, data)` once and `(false, "used")` after that.
//
// Each check is a flat helper: one `for`, one `match`, and a direct boolean return. No
// nested match/if chain.

contract checkCredentialProof(Proof, @validator, @credentialUri, @height, ret) = {
  new tCh in {
    Proof!("take", *tCh) |
    for (@t <- tCh) {
      match t {
        (true, data) => {
          ret!(data.get("subject") == validator
            && data.get("credentialUri") == credentialUri
            && data.get("atHeight") == height)
        }
        _ => { ret!(false) }
      }
    }
  }
} |

contract proveAndCheck(@credentialUri, dId, @rq, @validator, @height, ret) = {
  new credCh in {
    rl!(credentialUri, *credCh) |
    for (Credential <- credCh) {
      proveAndCheckCall!(*Credential, credentialUri, *dId, rq, validator, height, *ret)
    }
  }
} |

contract proveAndCheckCall(Credential, @credentialUri, dId, @rq, @validator, @height, ret) = {
  new statusCh, proofCh in {
    Credential!("prove", *dId, rq, *statusCh, *proofCh) |
    for (@s <- statusCh) {
      proveAndCheckReply!(s, *proofCh, validator, credentialUri, height, *ret)
    }
  }
} |

contract proveAndCheckReply(@s, proofCh, @validator, @credentialUri, @height, ret) = {
  match s {
    (true, _) => { proveTakeAndCheck!(*proofCh, validator, credentialUri, height, *ret) }
    _ => { ret!(false) }
  }
} |

contract proveTakeAndCheck(proofCh, @validator, @credentialUri, @height, ret) = {
  new okCh in {
    for (Proof <- proofCh) {
      checkCredentialProof!(*Proof, validator, credentialUri, height, *okCh) |
      for (@ok <- okCh) { ret!(ok) }
    }
  }
} |

contract checkValidatedProof(Proof, @caller, @atHeight, ret) = {
  new tCh in {
    Proof!("take", *tCh) |
    for (@t <- tCh) {
      match t {
        (true, data) => {
          ret!(data.get("caller") == caller && data.get("atHeight") == atHeight)
        }
        _ => { ret!(false) }
      }
    }
  }
} |

contract proveValidatedAndCheck(@vpUri, dId, @caller, @atHeight, ret) = {
  new vpc in {
    rl!(vpUri, *vpc) |
    for (VP <- vpc) { proveValidatedCall!(*VP, vpUri, *dId, caller, atHeight, *ret) }
  }
} |

contract proveValidatedCall(VP, @vpUri, dId, @caller, @atHeight, ret) = {
  new statusCh, proofCh in {
    VP!("proveValidated", *dId, atHeight, *statusCh, *proofCh) |
    for (@s <- statusCh) {
      proveValidatedReply!(s, *proofCh, caller, atHeight, *ret)
    }
  }
} |

contract proveValidatedReply(@s, proofCh, @caller, @atHeight, ret) = {
  match s {
    (true, _) => { proveValidatedTake!(*proofCh, caller, atHeight, *ret) }
    _ => { ret!(false) }
  }
} |

contract proveValidatedTake(proofCh, @caller, @atHeight, ret) = {
  new okCh in {
    for (Proof <- proofCh) {
      checkValidatedProof!(*Proof, caller, atHeight, *okCh) |
      for (@ok <- okCh) { ret!(ok) }
    }
  }
} |
// One outcome-to-status table. The K-Asset and value-proposition applyDecision arms use the
// same mapping; keeping it in one helper stops the two copies from drifting. An unknown
// outcome returns Nil, which the caller turns into an explicit refusal.

contract outcomeStatus(@outcome, ret) = {
  match outcome {
    "uphold" => { ret!("upheld") }
    "revoke" => { ret!("revoked") }
    "partial" => { ret!("partially_revoked") }
    _ => { ret!(Nil) }
  }
} |

  contract vpReqOk(@req, @height, ret) = {
    match req.get("subjectRef") {
      Nil => { ret!(false) }
      sr => {
        match (req.get("statementHash"), req.get("termsHash"),
               req.get("selectionCriteria"), req.get("deadlineHeight")) {
          (s, t, sc, d) => {
            if (s == Nil || s == "" || t == Nil || t == ""
                || sc == Nil || d == Nil || d <= height) { ret!(false) }
            else { ret!(true) }
          }
        }
      }
    }
  } |

  rl!(`__CREDENTIAL_FACTORY_URI__`, *cfCh) |
  rl!(`__ORACLE_FACTORY_URI__`, *ofCh) |
  for (CredentialFactory <- cfCh; OracleFactory <- ofCh) {
    new ValuePropositionFactory in {
      new vpRegistryState in {
      vpRegistryState!({}) |

      contract ValuePropositionFactory(@"verify", @uri, ret) = {
        for (@r <<- vpRegistryState) {
          match r.get(uri.toString()) {
            Nil => { ret!((false, "unknown value proposition")) }
            rec => { ret!((true, rec)) }
          }
        }
      } |

      contract ValuePropositionFactory(@"propose", dId, @req, ret) = {
        new aCh, hCh in {
          authSubject!(*dId, *aCh) |
          nowHeight!(*hCh) |
          for (@(true, proposer) <- aCh; @height <- hCh) {
            new okCh in {
              vpReqOk!(req, height, *okCh) |
              for (@ok <- okCh) {
                if (not ok) {
                  ret!((false, "fields"))
                } else {
                  new vpState, ValueProposition, Apply, openVpDispute,
                      vpApplyGate, vpApplyOutcome, uriCh in {
                    vpState!({
                      "uri": "",
                      "proposer": proposer,
                      "subjectRef": req.get("subjectRef"),
                      "statementHash": req.get("statementHash"),
                      "valueModelHash": req.get("valueModelHash"),
                      "beneficiaries": req.get("beneficiaries"),
                      "termsHash": req.get("termsHash"),
                      "selectionCriteria": req.get("selectionCriteria"),
                      "status": "proposed",
                      "validator": Nil,
                      "validation": Nil,
                      "comments": [],
                      "deadlineHeight": req.get("deadlineHeight"),
                      "dispute": Nil,
                      "revocation": Nil,
                      "createdAt": height,
                      "version": 1
                    }) |

                    contract ValueProposition(@"get", ret2) = {
                      for (@s <<- vpState) { ret2!((true, s)) }
                    } |

                    contract ValueProposition(@"comments", ret2) = {
                      for (@s <<- vpState) { ret2!((true, s.get("comments"))) }
                    } |

                    contract ValueProposition(@"comment", dId2, @comment, ret2) = {
                      new a2, h2 in {
                        authSubject!(*dId2, *a2) |
                        nowHeight!(*h2) |
                        for (@(true, who) <- a2; @now <- h2) {
                          for (@s <- vpState) {
                            if (s.get("status") != "proposed") {
                              vpState!(s) | ret2!((false, "not proposed"))
                            } else {
                              if (now > s.get("deadlineHeight")) {
                                vpState!(s) | ret2!((false, "clock"))
                              } else {
                                vpState!(s.set("comments", s.get("comments") ++ [{
                                  "id": "cm:" ++ who ++ ":" ++ now.toString(),
                                  "by": who, "hash": comment.get("hash"), "at": now}])
                                  .set("version", s.get("version") + 1)) |
                                ret2!((true, Nil))
                              }
                            }
                          }
                        }
                      }
                    } |

                    contract ValueProposition(@"withdraw", dId2, ret2) = {
                      new a2, h2 in {
                        authSubject!(*dId2, *a2) |
                        nowHeight!(*h2) |
                        for (@(true, who) <- a2; @now <- h2) {
                          for (@s <- vpState) {
                            if (who != s.get("proposer")) {
                              vpState!(s) | ret2!((false, "not proposer"))
                            } else {
                              if (s.get("status") != "proposed") {
                                vpState!(s) | ret2!((false, "not proposed"))
                              } else {
                                vpState!(s.set("status", "withdrawn")
                                          .set("version", s.get("version") + 1)) |
                                ret2!((true, Nil))
                              }
                            }
                          }
                        }
                      }
                    } |

                    contract ValueProposition(@"validate", dId2, @credentialUri, @validation, ret2) = {
                      new a2, h2 in {
                        authSubject!(*dId2, *a2) |
                        nowHeight!(*h2) |
                        for (@(true, validator) <- a2; @height <- h2) {
                          for (@s <- vpState) {
                            match (s.get("status"), validator == s.get("proposer"),
                                   height > s.get("deadlineHeight")) {
                              ("proposed", false, false) => {
                                new vfCh, okCh in {
                                  CredentialFactory!("verify", credentialUri, *vfCh) |
                                  for (@vf <- vfCh) {
                                    match vf {
                                      (true, _) => {
                                        proveAndCheck!(credentialUri, *dId2,
                                          s.get("selectionCriteria"), validator, height, *okCh) |
                                        for (@ok <- okCh) {
                                          if (ok) {
                                            vpState!(s.set("status", "validated")
                                              .set("validator", validator)
                                              .set("validation", {
                                                "validator": validator,
                                                "credentialUri": credentialUri,
                                                "notesHash": validation.get("notesHash"),
                                                "at": height})
                                              .set("version", s.get("version") + 1)) |
                                            ret2!((true, Nil))
                                          } else { vpState!(s) | ret2!((false, "proof")) }
                                        }
                                      }
                                      _ => { vpState!(s) | ret2!((false, "forged credential")) }
                                    }
                                  }
                                }
                              }
                              ("proposed", true, _) => { vpState!(s) | ret2!((false, "self validation")) }
                              ("proposed", _, true) => { vpState!(s) | ret2!((false, "deadline")) }
                              _ => { vpState!(s) | ret2!((false, "not proposed")) }
                            }
                          }
                        }
                      }
                    } |

                    contract ValueProposition(@"proveValidated", dId2, @atHeight, ret2, proofCh) = {
                      new a2, h2 in {
                        authSubject!(*dId2, *a2) |
                        nowHeight!(*h2) |
                        for (@(true, who) <- a2; @now <- h2) {
                          for (@s <- vpState) {
                            match (s.get("status") == "validated", atHeight == now) {
                              (false, _) => { vpState!(s) | ret2!((false, "not validated")) }
                              (true, false) => { vpState!(s) | ret2!((false, "height")) }
                              (true, true) => {
                              new proofState, Proof in {
                                proofState!({
                                  "data": {
                                    "uri": s.get("uri"),
                                    "atHeight": atHeight,
                                    "caller": who
                                  },
                                  "used": false
                                }) |
                                contract Proof(@"take", ret3) = {
                                  for (@p <- proofState) {
                                    if (p.get("used")) {
                                      proofState!(p) | ret3!((false, "used"))
                                    } else {
                                      proofState!(p.set("used", true)) |
                                      ret3!((true, p.get("data")))
                                    }
                                  }
                                } |
                                vpState!(s) |
                                proofCh!(bundle+{*Proof}) |
                                ret2!((true, Nil))
                              }
                              }
                              _ => { vpState!(s) | ret2!((false, "not validated")) }
                            }
                          }
                        }
                      }
                    } |

                    contract openVpDispute(@s, @who, @parties, @caseReq, dId, ret2) = {
                      new oCh in {
                        OracleFactory!("open", *dId, s.get("subjectRef"), {
                          "kind": caseReq.get("kind"),
                          "openedBy": who,
                          "parties": parties,
                          "groundsHash": caseReq.get("groundsHash"),
                          "requirement": {"ctype": "Oracle",
                                          "discipline": s.get("selectionCriteria").get("discipline"),
                                          "jurisdiction": s.get("selectionCriteria").get("jurisdiction"),
                                          "role": "oracle", "minLevel": 1},
                          "adjudicator": caseReq.get("adjudicator"),
                          "adjudicatorCredentialUri": caseReq.get("adjudicatorCredentialUri"),
                          "deadlineHeight": caseReq.get("deadlineHeight")
                        }, *Apply, *oCh) |
                        for (@o <- oCh) {
                          match o {
                            (true, caseRef) => {
                              vpState!(s.set("status", "disputed")
                                         .set("dispute", caseRef)
                                         .set("version", s.get("version") + 1)) |
                              ret2!((true, caseRef))
                            }
                            _ => { vpState!(s) | ret2!(o) }
                          }
                        }
                      }
                    } |

                    contract ValueProposition(@"openDispute", dId2, @caseReq, ret2) = {
                      new a2 in {
                        authSubject!(*dId2, *a2) |
                        for (@(true, who) <- a2) {
                          for (@s <- vpState) {
                            match (who == s.get("proposer") || who == s.get("validator"),
                                   s.get("status") == "proposed"
                                     || s.get("status") == "validated",
                                   s.get("dispute")) {
                              (false, _, _) => { vpState!(s) | ret2!((false, "not a party")) }
                              (true, false, _) => { vpState!(s) | ret2!((false, "not disputable")) }
                              (true, true, Nil) => {
                                match s.get("validator") {
                                  Nil => {
                                    openVpDispute!(s, who, [s.get("proposer")], caseReq,
                                                   *dId2, *ret2)
                                  }
                                  v => {
                                    openVpDispute!(s, who, [s.get("proposer"), v], caseReq,
                                                   *dId2, *ret2)
                                  }
                                }
                              }
                              (true, true, _) => {
                                vpState!(s) | ret2!((false, "already disputed"))
                              }
                              _ => { vpState!(s) | ret2!((false, "not a party")) }
                            }
                          }
                        }
                      }
                    } |

                    contract ValueProposition(@"revocation", ret2) = {
                      for (@s <<- vpState) { ret2!((true, s.get("revocation"))) }
                    } |

                    contract vpApplyGate(@s, @d, @caseId, @decision, ret2) = {
                      match (d.get("id") == caseId, s.get("status") == "disputed") {
                        (false, _) => { vpState!(s) | ret2!((false, "case mismatch")) }
                        (true, false) => { vpState!(s) | ret2!((false, "not disputed")) }
                        (true, true) => { vpApplyOutcome!(s, decision, *ret2) }
                        _ => { vpState!(s) | ret2!((false, "case mismatch")) }
                      }
                    } |

                    contract vpApplyOutcome(@s, @decision, ret2) = {
                      new osCh in {
                        outcomeStatus!(decision.get("outcome"), *osCh) |
                        for (@status <- osCh) {
                          match status {
                            Nil => { vpState!(s) | ret2!((false, "outcome")) }
                            target => {
                              vpState!(s.set("status", target)
                                        .set("revocation", decision)
                                        .set("version", s.get("version") + 1)) |
                              ret2!((true, target))
                            }
                          }
                        }
                      }
                    } |

                    contract Apply(@"applyDecision", @caseId, @decision, ret2) = {
                      for (@s <- vpState) {
                        match s.get("dispute") {
                          Nil => { vpState!(s) | ret2!((false, "no dispute")) }
                          d => { vpApplyGate!(s, d, caseId, decision, *ret2) }
                        }
                      }
                    } |

                    rs!(bundle+{*ValueProposition}, *uriCh) |
                    for (@uri <- uriCh) {
                      for (@s2 <- vpState) {
                        vpState!(s2.set("uri", uri)) |
                        for (@r <- vpRegistryState) {
                          vpRegistryState!(r.set(uri.toString(), {
                            "uri": uri,
                            "proposer": proposer,
                            "subjectRef": req.get("subjectRef"),
                            "statementHash": req.get("statementHash")
                          })) |
                          ret!((true, {"id": uri, "uri": uri}))
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      } |

      rs!(bundle+{*ValuePropositionFactory}, *cFactory) |
      for (@uri <- cFactory) {
        rl!(`__ROOT_URI__`, *rootCh) |
        for (Root <- rootCh) {
          Root!("register", "component:value-proposition-factory", uri, 1, "value",
                *deployerId, *ack1) |
          for (@r <- ack1) { deployId!([("value-proposition-factory", uri)]) }
        }
      }
      }
    }
  }
}
